Notebook[{

Cell[CellGroupData[{
Cell["\<\
Let\[CloseCurlyQuote]s take a look at the conditions for A-stability for \
2-step methods\
\>", "Subsection",
 CellChangeTimes->{{3.98091255249671*^9, 
  3.980912577554489*^9}},ExpressionUUID->"25fdc974-5b7e-b140-b1b0-\
f09409427f86"],

Cell[CellGroupData[{

Cell["First, the consistency conditions", "Subsubsection",
 CellChangeTimes->{{3.9875795436201897`*^9, 
  3.9875795494002075`*^9}},ExpressionUUID->"7990e8a6-aa73-3741-9b86-\
13a3f4a80f62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"orderConditions", "=", 
  RowBox[{
   RowBox[{"And", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Alpha]", "i"], " ", 
          SuperscriptBox["i", 
           RowBox[{"q", "+", "\[Epsilon]"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}], "==", 
       RowBox[{"q", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Beta]", "i"], " ", 
           SuperscriptBox[
            RowBox[{"(", "i", ")"}], 
            RowBox[{"q", "+", "\[Epsilon]", "-", "1"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "/.", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{
      SuperscriptBox["0", "\[Epsilon]"], "->", "1"}], ",", " ", 
     RowBox[{
      SuperscriptBox["0", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Epsilon]"}]], "->", "0"}], ",", 
     RowBox[{"\[Epsilon]", "->", "0"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.98091181951746*^9, 3.9809118259787846`*^9}, {
  3.9846320018406105`*^9, 3.984632001943939*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"7df275a5-d2ff-6d44-bf12-02432a262039"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "+", 
    SubscriptBox["\[Alpha]", "1"], "+", 
    SubscriptBox["\[Alpha]", "2"]}], "\[Equal]", "0"}], "&&", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], "+", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Alpha]", "2"]}]}], "\[Equal]", 
   RowBox[{
    SubscriptBox["\[Beta]", "0"], "+", 
    SubscriptBox["\[Beta]", "1"], "+", 
    SubscriptBox["\[Beta]", "2"]}]}], "&&", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], "+", 
    RowBox[{"4", " ", 
     SubscriptBox["\[Alpha]", "2"]}]}], "\[Equal]", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Beta]", "1"], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "2"]}]}], ")"}]}]}]}]], "Output",
 CellChangeTimes->{3.9809118276795063`*^9, 3.9846320043130074`*^9, 
  3.9879876003085575`*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"bbf2d2b5-115d-4243-b983-5d3a5120f8e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BDFLikeOrderConditions", "=", 
  RowBox[{"orderConditions", "/.", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], "->", "1"}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9809118470335083`*^9, 3.980911850741188*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"f643c49f-52db-8a45-af36-b43fbfe1b00a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"1", "+", 
    SubscriptBox["\[Alpha]", "0"], "+", 
    SubscriptBox["\[Alpha]", "1"]}], "\[Equal]", "0"}], "&&", 
  RowBox[{
   RowBox[{"2", "+", 
    SubscriptBox["\[Alpha]", "1"]}], "\[Equal]", 
   RowBox[{
    SubscriptBox["\[Beta]", "0"], "+", 
    SubscriptBox["\[Beta]", "1"], "+", 
    SubscriptBox["\[Beta]", "2"]}]}], "&&", 
  RowBox[{
   RowBox[{"4", "+", 
    SubscriptBox["\[Alpha]", "1"]}], "\[Equal]", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Beta]", "1"], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "2"]}]}], ")"}]}]}]}]], "Output",
 CellChangeTimes->{3.9809118518994427`*^9, 3.9846320070635033`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"5e086b12-8735-0047-bc67-014dce436d71"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"reducedBDFLikeOrderConditions", "=", 
  RowBox[{
   RowBox[{"Reduce", "[", "BDFLikeOrderConditions", "]"}], "//", 
   "ToRules"}]}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"22a6232a-c6ad-504f-965f-f6bc7e2e6d35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Beta]", "0"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "2"}], "+", 
     SubscriptBox["\[Beta]", "1"], "+", 
     RowBox[{"3", " ", 
      SubscriptBox["\[Beta]", "2"]}]}]}], ",", 
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "4"}], "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Beta]", "1"]}], "+", 
     RowBox[{"4", " ", 
      SubscriptBox["\[Beta]", "2"]}]}]}], ",", 
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "\[Rule]", 
    RowBox[{"3", "-", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Beta]", "1"]}], "-", 
     RowBox[{"4", " ", 
      SubscriptBox["\[Beta]", "2"]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9809118673008842`*^9, 3.984632008999037*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"3ceb2aaa-d212-1b43-b8d1-f60d3e7b6b28"]
}, Open  ]]
}, Open  ]],

