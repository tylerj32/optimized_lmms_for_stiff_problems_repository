Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s see how it compares to BDF-like method \
conditions", "Subsection",
 CellChangeTimes->{{3.980913429030157*^9, 
  3.980913448396246*^9}},ExpressionUUID->"def0db73-9332-a64f-a296-\
a8d8c86aa6d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"astablecond", "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Beta]0", "->", "0"}], ",", 
    RowBox[{"\[Beta]1", "->", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9809132854732018`*^9, 3.980913312201996*^9}, {
  3.980913398265751*^9, 3.9809134007299385`*^9}},
 CellLabel->
  "In[163]:=",ExpressionUUID->"e7c4aeeb-66ee-1444-ad38-ee67fb8084ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", "\[Beta]2"}], ")"}], " ", "\[Beta]2"}], "\[LessEqual]",
    "0"}], "&&", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "-", 
      RowBox[{"3", " ", "\[Beta]2"}]}], ")"}], " ", "\[Beta]2"}], "\[LessEqual]",
    "0"}], "&&", 
  RowBox[{
   SuperscriptBox["\[Beta]2", "2"], "\[GreaterEqual]", "0"}], "&&", 
  RowBox[{"\[Beta]2", "\[NotEqual]", "0"}]}]], "Output",
 CellChangeTimes->{3.9809133130338345`*^9, 3.980913401415327*^9},
 CellLabel->
  "Out[163]=",ExpressionUUID->"03135742-8e9c-8f47-8205-18ad7a08e543"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Beta]2"}], ")"}], " ", "\[Beta]2"}], "\[LessEqual]",
     "0"}], "&&", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "-", 
       RowBox[{"3", " ", "\[Beta]2"}]}], ")"}], " ", "\[Beta]2"}], "\[LessEqual]",
     "0"}], "&&", 
   RowBox[{
    SuperscriptBox["\[Beta]2", "2"], "\[GreaterEqual]", "0"}], "&&", 
   RowBox[{"\[Beta]2", "\[NotEqual]", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.98091332516028*^9, 3.9809133282385178`*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"0533961f-d306-8e41-b724-ae207c346d3c"],

Cell[BoxData[
 RowBox[{
  FractionBox["2", "3"], "\[LessEqual]", "\[Beta]2", "\[LessEqual]", 
  "2"}]], "Output",
 CellChangeTimes->{3.9809133300251064`*^9, 3.980913404682188*^9},
 CellLabel->
  "Out[164]=",ExpressionUUID->"77aab2c3-717f-9541-8cb1-7fcc1639ef4a"]
}, Open  ]],

Cell[TextData[{
 "This matches what was found for BDF-like methods (also, ",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55841038-575f-a34e-8cd6-779ee324e7f8"],
 " corresponds to BDF2)"
}], "Subsubsection",
