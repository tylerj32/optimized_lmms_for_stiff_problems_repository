Cell[CellGroupData[{

Cell["\<\
Ensuring no common roots (now no longer necessary for the paper)\
\>", "Subsubsection",
 CellChangeTimes->{{3.9875797192029343`*^9, 
  3.987579733803097*^9}},ExpressionUUID->"a0ade94b-e82e-a64a-9d92-\
3705954f8f85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Resultant", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"3", "-", 
           RowBox[{"2", " ", 
            SubscriptBox["\[Beta]", "1"]}], "-", 
           RowBox[{"4", " ", 
            SubscriptBox["\[Beta]", "2"]}]}], ",", 
          RowBox[{
           RowBox[{"-", "4"}], "+", 
           RowBox[{"2", " ", 
            SubscriptBox["\[Beta]", "1"]}], "+", 
           RowBox[{"4", " ", 
            SubscriptBox["\[Beta]", "2"]}]}], ",", "1"}], "}"}], "]"}], "[", 
       "\[Zeta]", "]"}], ",", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           SubscriptBox["\[Beta]", "1"], "+", 
           RowBox[{"3", " ", 
            SubscriptBox["\[Beta]", "2"]}]}], ",", 
          SubscriptBox["\[Beta]", "1"], ",", 
          SubscriptBox["\[Beta]", "2"]}], "}"}], "]"}], "[", "\[Zeta]", "]"}],
       ",", "\[Zeta]"}], "]"}], "==", "0"}], ",", 
   SubscriptBox["\[Beta]", "1"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9846365582119045`*^9, 3.9846365610293274`*^9}, {
  3.9846366294178505`*^9, 3.984636699184849*^9}, {3.9846367367438583`*^9, 
  3.9846367607991962`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"379d698f-06d1-4e4d-a93f-ddb9b0f4c76d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Beta]", "1"], "\[Rule]", 
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "2"]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Beta]", "1"], "\[Rule]", 
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "2"]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Beta]", "1"], "\[Rule]", 
     RowBox[{"1", "-", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "2"]}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9846366812831764`*^9, 3.984636700509733*^9}, {
  3.9846367415267735`*^9, 3.9846367617363415`*^9}},
 CellLabel->"Out[46]=",ExpressionUUID->"bbfc710c-a4c5-3b47-8390-0cbaf427923a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"-", "2"}], "+", 
    RowBox[{"2", 
     SubscriptBox["\[Beta]", "1"]}], "+", 
    RowBox[{"4", " ", 
     SubscriptBox["\[Beta]", "2"]}]}], "!=", "0"}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.9846377881019344`*^9, 3.984637813296461*^9}},
