 RowBox[{
  RowBox[{
   SubscriptBox["\[Beta]", "1"], "+", 
   RowBox[{"2", " ", 
    SubscriptBox["\[Beta]", "2"]}]}], "\[NotEqual]", "1"}]], "Output",
 CellChangeTimes->{3.9846378137696953`*^9},
