   RowBox[{
    RowBox[{"variablestepcond", "[", 
     RowBox[{"5", ",", "5"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "5"}]], "->", "1"}], ",", 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "4"}]], "->", "0"}], ",", 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "3"}]], "->", "0"}], ",", 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "2"}]], "->", "0"}], ",", 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "1"}]], "->", "0"}], ",", 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "0"}]], "->", "0"}]}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.988784354616186*^9, 3.9887844080966873`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"9aca3d23-8dec-4e4d-95b7-4eca713f0605"],

