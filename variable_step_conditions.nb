            RowBox[{"1", "+", 
             RowBox[{"2", " ", 
              SubscriptBox["\[Omega]", "n"]}]}]], "\[Zeta]"}], "+", 
          SuperscriptBox["\[Zeta]", "2"]}], "==", "0"}], ",", "\[Zeta]"}], 
       "]"}]}], "//", "Simplify"}], "]"}], "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]], "Input",
