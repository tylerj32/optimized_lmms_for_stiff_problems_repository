Cell[BoxData[
 RowBox[{
  RowBox[{"variablestepcond", "[", "k_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "k"], 
         RowBox[{
          SubscriptBox["\[Alpha]", 
           RowBox[{"n", ",", "j"}]], 
          SuperscriptBox[
           RowBox[{"c", "[", "j", "]"}], 
           RowBox[{"m", "+", "\[Epsilon]"}]]}]}], ")"}], "==", 
       RowBox[{"(", 
        RowBox[{"m", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], "k"], 
          RowBox[{
           SubscriptBox["\[Beta]", 
            RowBox[{"n", ",", "j"}]], 
           SuperscriptBox[
            RowBox[{"c", "[", "j", "]"}], 
            RowBox[{"m", "-", "1", "+", "\[Epsilon]"}]]}]}]}], ")"}]}], ")"}],
      "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["0", "\[Epsilon]"], "->", "1"}], ",", 
       RowBox[{"\[Epsilon]", "->", "0"}], ",", " ", 
       RowBox[{
        SuperscriptBox["0", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Epsilon]"}]], "->", "0"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9868907092127*^9, 3.986890712928545*^9}, {
  3.9868907499764156`*^9, 3.9868907598534374`*^9}, {3.9868907978175125`*^9, 
