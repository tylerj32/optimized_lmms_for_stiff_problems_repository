Cell[BoxData[
 RowBox[{
  RowBox[{"variablestepcond", "[", 
   RowBox[{"p_", ",", "k_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "k"], 
         RowBox[{
          SubscriptBox["\[Alpha]", 
           RowBox[{"n", ",", "j"}]], 
          SuperscriptBox[
           RowBox[{"c", "[", 
            RowBox[{"j", ",", "k"}], "]"}], 
           RowBox[{"m", "+", "\[Epsilon]"}]]}]}], ")"}], "==", 
       RowBox[{"(", 
        RowBox[{"m", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], "k"], 
          RowBox[{
           SubscriptBox["\[Beta]", 
            RowBox[{"n", ",", "j"}]], 
           SuperscriptBox[
            RowBox[{"c", "[", 
             RowBox[{"j", ",", "k"}], "]"}], 
            RowBox[{"m", "-", "1", "+", "\[Epsilon]"}]]}]}]}], ")"}]}], ")"}],
      "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["0", "\[Epsilon]"], "->", "1"}], ",", 
       RowBox[{"\[Epsilon]", "->", "0"}], ",", " ", 
       RowBox[{
        SuperscriptBox["0", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Epsilon]"}]], "->", "0"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "p"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9868907092127*^9, 3.986890712928545*^9}, {
  3.9868907499764156`*^9, 3.9868907598534374`*^9}, {3.9868907978175125`*^9, 
  3.986890800577553*^9}, {3.9868912475718765`*^9, 3.9868912573419857`*^9}, {
  3.986961543728525*^9, 3.986961557036461*^9}, {3.98696332506382*^9, 
  3.986963347704771*^9}, {3.98696340053463*^9, 3.986963403731802*^9}, {
  3.9869640830715923`*^9, 3.986964090944088*^9}, {3.9870448875935364`*^9, 
