Cell[BoxData[
 RowBox[{
  RowBox[{"c3", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{
     RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"c", "[", "j", "]"}], "3"], 
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
       RowBox[{"3", "!"}]], "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"c", "[", "j", "]"}], 
         RowBox[{"3", "-", "1"}]], 
        RowBox[{"b", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{
        RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9809140949009514`*^9, 3.9809141064541473`*^9}, {
