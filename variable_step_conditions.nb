Cell[TextData[{
 "Therefore, the consistency conditions are as follows:\nOrder 0: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     SubscriptBox["\[Alpha]", "j"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"a0a21078-404e-2745-8f61-c206091913c7"],
 "\nOrder 1: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "j"}]], 
      SubscriptBox["c", "j"]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     SubscriptBox["\[Beta]", 
      RowBox[{"n", ",", "j"}]]}]}], TraditionalForm]],ExpressionUUID->
  "9c838dee-75f8-7145-a808-d67e96f638d1"],
 "\nOrder 2: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "j"}]], 
      SubsuperscriptBox["c", "j", "2"]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Beta]", 
       RowBox[{"n", ",", "j"}]], 
      SubscriptBox["c", "j"]}]}]}], TraditionalForm]],ExpressionUUID->
  "3214640e-2168-1244-a26c-0b49fb8366d6"],
 "\nOrder 3: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "j"}]], 
      SubsuperscriptBox["c", "j", "3"]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Beta]", 
       RowBox[{"n", ",", "j"}]], 
      SubsuperscriptBox["c", "j", "2"]}]}]}], TraditionalForm]],
  ExpressionUUID->"1ba068af-299f-6c4d-85ff-c3b4979a38c2"]
}], "Subsubsection",
 CellChangeTimes->{{3.9868902843792953`*^9, 3.986890307764818*^9}, {
  3.9868926337245255`*^9, 
  3.986892640515133*^9}},ExpressionUUID->"5c98faf4-810f-ac4b-bf77-\
a5e8c3af0c56"],

Cell[CellGroupData[{

Cell["We give the order conditions as a function below:", "Subsubsection",
 CellChangeTimes->{{3.98689033287945*^9, 
  3.9868903533439903`*^9}},ExpressionUUID->"de54f65a-7e2d-8d4c-a503-\
f0f25cf6bd89"],

Cell[BoxData[
 RowBox[{"Clear", "[", "c", "]"}]], "Input",
 CellChangeTimes->{{3.987044637915163*^9, 3.987044639626604*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"3731ffb9-49c9-0d44-9bdc-a110b069b0a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", "[", "j_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"j", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SubscriptBox["\[Omega]", "n"]], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"j", "-", "2"}]], 
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"l", "=", "1"}], "i"], 
           SubscriptBox["\[Omega]", 
            RowBox[{"n", "+", "l"}]]}], ")"}]}]}], ",", 
       RowBox[{"j", ">=", "1"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9880049372333336`*^9, 3.98800494328384*^9}, 
   3.988004979806288*^9, {3.9880061977828693`*^9, 3.988006291408367*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"6aeb1035-34e6-114a-828b-8e74dc2e4660"],

