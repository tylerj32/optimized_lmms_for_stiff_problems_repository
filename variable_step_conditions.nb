Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Alpha]", 
      RowBox[{"n", ",", "0"}]], "+", 
     SubscriptBox["\[Alpha]", 
      RowBox[{"n", ",", "1"}]], "+", 
     SubscriptBox["\[Alpha]", 
      RowBox[{"n", ",", "2"}]]}], "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{
     FractionBox[
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "1"}]], 
      SubscriptBox["\[Omega]", "n"]], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox["1", 
         SubscriptBox["\[Omega]", "n"]]}], ")"}], " ", 
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "2"}]]}]}], "\[Equal]", 
    RowBox[{
     SubscriptBox["\[Beta]", 
      RowBox[{"n", ",", "0"}]], "+", 
     SubscriptBox["\[Beta]", 
      RowBox[{"n", ",", "1"}]], "+", 
     SubscriptBox["\[Beta]", 
      RowBox[{"n", ",", "2"}]]}]}], ",", 
   RowBox[{
    RowBox[{
     FractionBox[
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "1"}]], 
      SubsuperscriptBox["\[Omega]", "n", "2"]], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox["1", 
          SubscriptBox["\[Omega]", "n"]]}], ")"}], "2"], " ", 
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "2"}]]}]}], "\[Equal]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SubscriptBox["\[Beta]", 
         RowBox[{"n", ",", "1"}]], 
        SubscriptBox["\[Omega]", "n"]], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox["1", 
           SubscriptBox["\[Omega]", "n"]]}], ")"}], " ", 
        SubscriptBox["\[Beta]", 
         RowBox[{"n", ",", "2"}]]}]}], ")"}]}]}]}], "}"}]], "Output",
