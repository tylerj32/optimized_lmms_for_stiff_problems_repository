Notebook[{
Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.987046586340616*^9, 3.987046609142044*^9}},
 CellLabel->
  "In[525]:=",ExpressionUUID->"1b485d0a-fd9a-4c4d-8f6f-5186913aba41"],

Cell[CellGroupData[{

Cell["\<\
In this notebook, we redefine the consistency conditions to accommodate \
variable step size LMMs\
\>", "Subsection",
 CellChangeTimes->{{3.986883516448704*^9, 3.9868835394428196`*^9}, {
  3.9868835759163113`*^9, 
  3.986883596452877*^9}},ExpressionUUID->"e4e0d282-d023-2247-bdbe-\
8d8094690ac7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "a_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9809141208829575`*^9, 3.980914121348284*^9}, {
  3.9809209866184216`*^9, 3.9809209874272385`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"8b159006-ae57-fd4a-9d95-9cf58fdd55a5"],

Cell[CellGroupData[{

Cell["First, we have the order conditions for a fixed step size:", \
"Subsubsection",
 CellChangeTimes->{{3.9868836022290363`*^9, 
  3.986883656472473*^9}},ExpressionUUID->"3df14bf2-a0e7-e540-95af-\
b89d66c4d1fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fixedordercond", "[", "p_", "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "2"], 
         RowBox[{
          SubscriptBox["\[Alpha]", "j"], 
          SuperscriptBox["j", 
           RowBox[{"m", "+", "\[Epsilon]"}]]}]}], ")"}], "==", 
       RowBox[{"(", 
        RowBox[{"m", 
         RowBox[{
          UnderoverscriptBox["\[Sum]", 
           RowBox[{"j", "=", "0"}], "2"], 
          RowBox[{
           SubscriptBox["\[Beta]", "j"], 
           SuperscriptBox["j", 
            RowBox[{"m", "-", "1", "+", "\[Epsilon]"}]]}]}]}], ")"}]}], ")"}],
      "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["0", "\[Epsilon]"], "->", "1"}], ",", 
       RowBox[{"\[Epsilon]", "->", "0"}], ",", " ", 
       RowBox[{
        SuperscriptBox["0", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Epsilon]"}]], "->", "0"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"m", ",", "0", ",", "p"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[499]:=",ExpressionUUID->"8958b467-a721-eb4b-a1cc-0df8444b8b0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fixedordercond", "[", "2", "]"}]], "Input",
 CellChangeTimes->{{3.986883662899868*^9, 3.986883693459383*^9}},
 CellLabel->
  "In[523]:=",ExpressionUUID->"0d4719f1-c2f7-e447-928f-32bb4fb81bb7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Alpha]", "0"], "+", 
     SubscriptBox["\[Alpha]", "1"], "+", 
     SubscriptBox["\[Alpha]", "2"]}], "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Alpha]", "2"]}]}], "\[Equal]", 
    RowBox[{
     SubscriptBox["\[Beta]", "0"], "+", 
     SubscriptBox["\[Beta]", "1"], "+", 
     SubscriptBox["\[Beta]", "2"]}]}], ",", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Alpha]", "1"], "+", 
     RowBox[{"4", " ", 
      SubscriptBox["\[Alpha]", "2"]}]}], "\[Equal]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Beta]", "1"], "+", 
       RowBox[{"2", " ", 
        SubscriptBox["\[Beta]", "2"]}]}], ")"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9868836672664375`*^9, 3.9868836940518*^9}, 
   3.9868918577984066`*^9, 3.987046524461334*^9, 3.987046599713516*^9},
 CellLabel->
  "Out[523]=",ExpressionUUID->"79650839-0fa9-0042-a039-e0073ff500b1"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "To change these conditions to fit variable step size methods, we go back to \
the truncation error, but allow h to be ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f04e78c-1e50-b346-8d08-1c9561d9d7e2"],
 ":\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "n"], ":=", 
    RowBox[{
     FractionBox["1", 
      SubscriptBox["h", "n"]], "[", 
     RowBox[{
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"j", "=", "0"}], "k"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{"n", ",", "j"}]], 
         RowBox[{"y", "[", 
          SubscriptBox["t", 
           RowBox[{"n", "+", "j"}]], "]"}]}], ")"}]}], "-", 
      RowBox[{
       SubscriptBox["h", "n"], 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"j", "=", "0"}], "k"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["\[Beta]", 
           RowBox[{"n", ",", "j"}]], 
          RowBox[{
           RowBox[{"y", "'"}], "[", 
           SubscriptBox["t", 
            RowBox[{"n", "+", "j"}]], "]"}]}], ")"}]}]}]}], "]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fef40fe1-6c1c-6f40-b0a1-7e9c81d26007"]
}], "Subsubsection",
 CellChangeTimes->{{3.9868837199681015`*^9, 3.986883751164221*^9}, {
  3.986883821956829*^9, 3.98688383612195*^9}, {3.98688390177096*^9, 
  3.9868839090896397`*^9}, {3.986883976849951*^9, 3.986884125757248*^9}, {
  3.9868845053661575`*^9, 3.9868845223979435`*^9}, {3.9868846489863205`*^9, 
  3.98688467405987*^9}, {3.9868855889005146`*^9, 3.9868857917659016`*^9}, {
  3.9868863028835945`*^9, 3.9868863445142937`*^9}, {3.986886544545719*^9, 
  3.986886553784519*^9}},ExpressionUUID->"20ff40c2-dbae-7e4a-9420-\
bbcd4326624a"],

Cell[TextData[{
 "ChatGPT then proposes this:\nGiven that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "j"], "=", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
     SubscriptBox["t", 
      RowBox[{"n", "+", "1", "-", "k"}]]}]}], TraditionalForm]],
  ExpressionUUID->"ba2c6dd3-13bf-184d-8042-8377bc1d17e8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "n"], "=", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"n", "+", "1"}]], "-", 
     SubscriptBox["t", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "b7c14dbe-b754-3648-8aa4-28f04d4a1249"],
 ", let us introduce a scaling variable ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],ExpressionUUID->
  "9e2863bf-5135-d148-a08e-f1f983f82af1"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "j"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["\[Tau]", "j"], 
      SubscriptBox["h", "n"]], "=", 
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}], 
      SubscriptBox["h", "n"]]}]}], TraditionalForm]],ExpressionUUID->
  "ce2729b8-900f-3b4f-8c5c-4aea84fe32da"],
 "\nThis is dimensionless. Note that if we have a fixed step size, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", 
     RowBox[{"n", "+", "j"}]], "=", 
    RowBox[{
     SubscriptBox["t", "n"], "+", 
     RowBox[{"j", " ", "h"}]}]}], TraditionalForm]],ExpressionUUID->
  "677eb650-c32b-3941-b25d-ac4b887258f9"],
 " and so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "j"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}], "h"], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"j", " ", "h"}], "h"], "=", "j"}]}]}], TraditionalForm]],
  ExpressionUUID->"9d32eb5a-021f-194d-a85e-c81de99e346e"]
}], "Subsubsection",
 CellChangeTimes->{{3.9868863495534496`*^9, 3.9868863826739826`*^9}, {
   3.9868864223329563`*^9, 3.9868864429030952`*^9}, {3.9868864923857784`*^9, 
   3.986886494810976*^9}, {3.986886581377527*^9, 3.98688659543462*^9}, {
   3.986886697385113*^9, 3.986886725979618*^9}, {3.9868869100567303`*^9, 
   3.9868869366010284`*^9}, {3.9868870229027977`*^9, 3.986887194971096*^9}, {
   3.986887310403183*^9, 3.986887323082636*^9}, 3.9868875900371475`*^9, {
   3.9898036820732727`*^9, 
   3.989803744465063*^9}},ExpressionUUID->"0a89dc25-049d-fc46-81dd-\
7c793280a090"],

Cell[TextData[{
 "We now implement the Taylor expansion:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "+", "j"}]], ")"}], "=", 
    RowBox[{
     RowBox[{"y", "(", 
      RowBox[{
       SubscriptBox["t", "n"], "+", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["t", 
          RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
         SubscriptBox["t", 
          RowBox[{"n", "+", "1", "-", "k"}]]}], ")"}]}], ")"}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"m", "=", "0"}], "\[Infinity]"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["t", 
             RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
            SubscriptBox["t", "n"]}], ")"}], "m"], 
         RowBox[{"m", "!"}]], 
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", "m", ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"a9c5f269-dabd-9e4e-aff0-02bd9b370864"],
 "\nRecall ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "j"], "=", 
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}], 
      SubscriptBox["h", "n"]]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"therefore", " ", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k", "+", "j"}]]}], "-", 
      SubscriptBox["t", 
       RowBox[{"n", "+", "1", "-", "k"}]]}], "=", 
     RowBox[{
      SubscriptBox["c", "j"], 
      SubscriptBox["h", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "3665e34c-0c8b-914d-8bbe-c46cbfa682c7"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "+", "j"}]], ")"}], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"m", "=", "0"}], "\[Infinity]"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["c", "j"], 
            SubscriptBox["h", "n"]}], ")"}], "m"], 
         RowBox[{"m", "!"}]], 
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", "m", ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}]}], ")"}]}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"m", "=", "0"}], "\[Infinity]"], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["h", "n", "m"], 
        FractionBox[
         SubsuperscriptBox["c", "j", "m"], 
         RowBox[{"m", "!"}]], 
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", "m", ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"a6a3724e-9525-d648-8828-52db6a0fa1bf"],
 "\nWe do the same for the derivative:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"y", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", 
       RowBox[{"n", "+", "j"}]], ")"}]}], "=", 
    RowBox[{
     RowBox[{"y", "(", 
      RowBox[{
       SubscriptBox["t", "n"], "+", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["t", 
          RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
         SubscriptBox["t", 
          RowBox[{"n", "+", "1", "-", "k"}]]}], ")"}]}], ")"}], "=", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"m", "=", "0"}], "\[Infinity]"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["c", "j"], 
            SubscriptBox["h", "n"]}], ")"}], "m"], 
         RowBox[{"m", "!"}]], 
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"aa21f273-c22c-3c4b-a7ba-39a64d0f3a7d"]
}], "Subsubsection",
 CellChangeTimes->{{3.9868875974707546`*^9, 3.9868876051369667`*^9}, {
  3.9868876669696655`*^9, 3.986887734873953*^9}, {3.986887847104244*^9, 
  3.9868878559405518`*^9}, {3.986887933335556*^9, 3.9868879701381435`*^9}, {
  3.986888005104664*^9, 3.9868881758247833`*^9}, {3.9868882737489033`*^9, 
  3.986888280955496*^9}, {3.9868883126897964`*^9, 3.9868883155231056`*^9}, {
  3.986888370713709*^9, 3.9868884065665436`*^9}, {3.986892123192295*^9, 
  3.986892129587431*^9}, {3.986955175128269*^9, 3.986955175128269*^9}, {
  3.989803749103321*^9, 3.9898037790890636`*^9}, {3.9898038093328342`*^9, 
  3.9898038115039654`*^9}},ExpressionUUID->"0c9f7432-f19b-5649-b0ae-\
1d15aba95345"],

Cell[TextData[{
 "*Note that for a fixed step size, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", 
     RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]], "+", 
       RowBox[{"j", " ", "h"}]}], "->", 
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k", "+", "j"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}]}], "=", 
     RowBox[{"j", " ", "h"}]}]}], TraditionalForm]],ExpressionUUID->
  "0c30b2db-c3a9-214d-8132-757d595de817"]
}], "Subsubsection",
 CellChangeTimes->{{3.9869551120186768`*^9, 3.9869551625335865`*^9}, {
  3.989803788180359*^9, 
  3.98980379453244*^9}},ExpressionUUID->"b1f3319c-ff35-2b40-959b-\
060076970777"],

Cell[TextData[{
 "We now substitute into the LTE:\nLHS (\[Alpha]-coefficients):\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"j", "=", "0"}], "k"], 
     RowBox[{
      SubscriptBox["\[Alpha]", 
       RowBox[{"n", ",", "j"}]], 
      RowBox[{"y", "[", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "j"}]], "]"}]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["h", "n", "m"], "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "k"], 
         RowBox[{
          SubscriptBox["\[Alpha]", 
           RowBox[{"n", ",", "j"}]], 
          SubsuperscriptBox["c", "j", "m"]}]}], ")"}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", "m", ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}], 
        RowBox[{"m", "!"}]]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "311068b7-a583-5b4a-8b75-7613dfae4bc9"],
 "\nRHS (\[Beta]-coefficients):\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["h", "n"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"j", "=", "0"}], "k"], 
      RowBox[{
       SubscriptBox["\[Beta]", 
        RowBox[{"n", ",", "j"}]], 
       RowBox[{
        RowBox[{"y", "'"}], "[", 
        SubscriptBox["t", 
         RowBox[{"n", "+", "j"}]], "]"}]}]}]}], "=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["h", "n", 
         RowBox[{"m", "+", "1"}]], "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "k"], 
         RowBox[{
          SubscriptBox["\[Beta]", 
           RowBox[{"n", ",", "j"}]], 
          SubsuperscriptBox["c", "j", "m"]}]}], ")"}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}], 
        RowBox[{"m", "!"}]]}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "3ccb16de-4389-8d48-bb1e-5ad8cdf9d4c9"],
 "\nShift index for RHS:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "1"}], "\[Infinity]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["h", "n", "m"], "(", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"j", "=", "0"}], "k"], 
         RowBox[{
          SubscriptBox["\[Beta]", 
           RowBox[{"n", ",", "j"}]], 
          SubsuperscriptBox["c", "j", 
           RowBox[{"m", "-", "1"}]]}]}], ")"}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["y", 
          RowBox[{"(", "m", ")"}]], "[", 
         SubscriptBox["t", "n"], "]"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "-", "1"}], ")"}], "!"}]]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"350cc635-785b-c945-af23-6baa89cde8e1"]
}], "Subsubsection",
 CellChangeTimes->{{3.986888418984247*^9, 3.9868885255722466`*^9}, {
  3.9868885815285683`*^9, 3.986888692906994*^9}, {3.986888724040451*^9, 
  3.986888866491329*^9}},ExpressionUUID->"0e552ac2-8448-5641-8065-\
83d75ed617b8"],

Cell[TextData[{
 "Notice how similar this is to the fixed step size conditions. The only \
difference is we now use ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "155c9395-666e-0b4c-aa5a-7affed8330e5"],
 " instead of j"
}], "Subsubsection",
 CellChangeTimes->{{3.9868888682854843`*^9, 3.9868889520244713`*^9}, {
  3.986888982425049*^9, 3.986889054607212*^9}, {3.9868891626994114`*^9, 
  3.986889245508707*^9}, {3.986889281277115*^9, 3.9868892928263817`*^9}, {
  3.986890274766735*^9, 
  3.986890275695362*^9}},ExpressionUUID->"a088f327-6efd-244a-acc1-\
825788bacea5"],

Cell[TextData[{
 "One last thing. Since we want our coefficients to be in terms of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "i"], "=", 
    FractionBox[
     SubscriptBox["h", "i"], 
     SubscriptBox["h", 
      RowBox[{"i", "-", "1"}]]]}], TraditionalForm]],ExpressionUUID->
  "096eb1d6-4367-4f40-88a1-04f7ee790b24"],
 ", we will enforce that on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "j"], TraditionalForm]],ExpressionUUID->
  "5e18da8b-e189-8f42-85e6-27a20113f8d6"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", " ", "=", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "91a6b839-4307-7c4e-93cf-0a1fbb9a5c4e"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "0"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}], 
      SubscriptBox["h", "n"]], "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "06e07ff9-d1c2-5e48-8285-004fc1b1b7ed"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "=", 
    RowBox[{"1", ":"}]}], TraditionalForm]],ExpressionUUID->
  "d1cce9e8-0e8c-2a44-afe3-444d3aeda6fa"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "1"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "2", "-", "k"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "+", "1", "-", "k"}]]}], 
      SubscriptBox["h", "n"]], "=", 
     RowBox[{
      FractionBox[
       SubscriptBox["h", 
        RowBox[{"n", "-", "1"}]], 
       SubscriptBox["h", "n"]], "=", 
      FractionBox["1", 
       SubscriptBox["\[Omega]", "n"]]}]}]}], TraditionalForm]],ExpressionUUID->
  "6e83336e-8122-9e45-8c07-a16f0c83b6b9"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "=", 
    RowBox[{"2", ":"}]}], TraditionalForm]],ExpressionUUID->
  "04b707ed-bc7b-934d-bcb4-ce6c6786a7ac"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "2"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "1"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "1"}]]}], 
      SubscriptBox["h", "n"]], "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["t", 
         RowBox[{"n", "+", "1"}]], "-", 
        SubscriptBox["t", "n"], "+", 
        SubscriptBox["t", "n"], "-", 
        SubscriptBox["t", 
         RowBox[{"n", "-", "1"}]]}], 
       SubscriptBox["h", "n"]], "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["h", "n"], "+", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}], 
        SubscriptBox["h", "n"]], "=", 
       RowBox[{"1", "+", 
        FractionBox["1", 
         SubscriptBox["\[Omega]", "n"]]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"90ec5094-0a45-0f4b-8633-6e3881a82e67"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "=", "3"}], TraditionalForm]],ExpressionUUID->
  "62f2dd9b-9013-084b-9300-d3fc4e90c2fd"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "3"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", 
        RowBox[{"n", "+", "2"}]], "-", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "1"}]]}], 
      SubscriptBox["h", "n"]], "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["t", 
         RowBox[{"n", "+", "2"}]], "-", 
        SubscriptBox["t", 
         RowBox[{"n", "+", "1"}]], "+", 
        SubscriptBox["t", 
         RowBox[{"n", "+", "1"}]], "-", 
        SubscriptBox["t", 
         RowBox[{"n", "-", "1"}]]}], 
       SubscriptBox["h", "n"]], "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "+", "1"}]], "+", 
         SubscriptBox["h", "n"], "+", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}], 
        SubscriptBox["h", "n"]], "=", 
       RowBox[{
        SubscriptBox["\[Omega]", 
         RowBox[{"n", "+", "1"}]], "+", "1", "+", 
        FractionBox["1", 
         SubscriptBox["\[Omega]", "n"]]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"576263f1-9475-9d44-850f-39a7f9643513"]
}], "Subsubsection",
