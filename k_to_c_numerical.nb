 RowBox[{
  RowBox[{"\[Kappa]list3b", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"NMinimize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c32beta", "[", 
              RowBox[{"\[Beta]2", ",", "\[Beta]3"}], "]"}], ",", 
             RowBox[{"trial2", "/.", " ", 
              RowBox[{"\[Kappa]", "->", "k"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Beta]2", ",", "\[Beta]3"}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<SimulatedAnnealing\>\""}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "1", ",", ".01"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
