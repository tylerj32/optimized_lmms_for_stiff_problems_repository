Cell[TextData[{
 "Finally, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "0"], "and", " ", 
    SubscriptBox["\[Beta]", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7017940-a7e4-1041-9586-1238b76951c7"],
 " are nonzero"
}], "Subsection",
 CellChangeTimes->{{3.9843799559674854`*^9, 
  3.984379981687132*^9}},ExpressionUUID->"daea219d-f97a-3b43-bdac-\
8134e227837f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond2beta3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"3", " ", 
            SubscriptBox["\[Beta]", "3"]}], "\[Equal]", "2"}], "&&", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["2", "3"]}], "<", 
           SubscriptBox["\[Beta]", "0"], "<", 
           FractionBox["2", "3"]}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"11", " ", 
            SubscriptBox["\[Beta]", "3"]}], "\[Equal]", "14"}], "&&", 
          RowBox[{
           FractionBox["6", "11"], "\[LessEqual]", 
           SubscriptBox["\[Beta]", "0"], "<", 
           FractionBox["14", "11"]}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["6", "11"], "<", 
           SubscriptBox["\[Beta]", "3"], "<", 
           FractionBox["2", "3"]}], "&&", 
          RowBox[{
           RowBox[{"6", "-", 
            RowBox[{"10", " ", 
             SubscriptBox["\[Beta]", "3"]}]}], "\[LessEqual]", 
           SubscriptBox["\[Beta]", "0"], "<", 
           SubscriptBox["\[Beta]", "3"]}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], "+", 
            RowBox[{"2", " ", 
             SubscriptBox["\[Beta]", "3"]}]}], "\[LessEqual]", 
           SubscriptBox["\[Beta]", "0"], "<", 
           SubscriptBox["\[Beta]", "3"]}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["2", "3"], "<", 
             SubscriptBox["\[Beta]", "3"], "<", 
             FractionBox["14", "11"]}], "||", 
            RowBox[{
             FractionBox["14", "11"], "<", 
             SubscriptBox["\[Beta]", "3"], "<", "2"}]}], ")"}]}], ")"}]}], 
       ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          SubscriptBox["\[Beta]", "0"], "]"}], "<", 
         RowBox[{"Abs", "[", 
          RowBox[{
           SuperscriptBox["\[Kappa]", "3"], " ", 
           SubscriptBox["\[Beta]", "3"]}], "]"}]}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           SubsuperscriptBox["\[Beta]", "0", "2"], "-", 
           RowBox[{
            SuperscriptBox["\[Kappa]", "6"], " ", 
            SubsuperscriptBox["\[Beta]", "3", "2"]}]}], "]"}], ">", "0"}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Beta]", "0"], "->", "\[Beta]0"}], ",", 
       RowBox[{
        SubscriptBox["\[Beta]", "3"], "->", "\[Beta]3"}]}], "}"}]}], "//", 
    "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9843809388766956`*^9, 3.984381019274107*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"f63ee810-156d-b94d-a822-86394a699e9c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32beta3", "[", 
   RowBox[{"\[Beta]0_", ",", "\[Beta]3_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         FractionBox[
          RowBox[{"3", " ", "\[Beta]0"}], "2"], "+", 
         FractionBox[
          RowBox[{"3", " ", "\[Beta]3"}], "2"]}], ",", 
        RowBox[{"3", "+", 
         RowBox[{"2", " ", "\[Beta]0"}], "-", 
         RowBox[{"4", " ", "\[Beta]3"}]}], ",", 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         FractionBox["\[Beta]0", "2"], "+", 
         FractionBox[
          RowBox[{"5", " ", "\[Beta]3"}], "2"]}], ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"{", 
       RowBox[{"\[Beta]0", ",", "0", ",", "0", ",", "\[Beta]3"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "//", "Simplify"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9843810505440464`*^9, 3.984381133053711*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"69f72d67-8ba5-0245-83b5-c9c0739c7d59"],

