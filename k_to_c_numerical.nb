          RowBox[{"c32step", "[", 
           RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "]"}], ",", 
          RowBox[{"trial", "/.", 
           RowBox[{"\[Kappa]", "->", "k"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0.00001", ",", ".99"}], "}"}], ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]", ",", " ", "\"\<|C|\>\""}], "}"}]}], ",", 
    RowBox[{"LabelStyle", "->", 
