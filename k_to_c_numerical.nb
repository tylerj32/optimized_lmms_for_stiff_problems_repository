Cell[BoxData[
 RowBox[{
  RowBox[{"c32beta2", "[", 
   RowBox[{"\[Beta]1_", ",", "\[Beta]3_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         FractionBox["\[Beta]1", "2"], "+", 
         FractionBox[
          RowBox[{"3", " ", "\[Beta]3"}], "2"]}], ",", 
        RowBox[{"3", "-", 
         RowBox[{"4", " ", "\[Beta]3"}]}], ",", 
        RowBox[{
         RowBox[{"-", "3"}], "+", 
         FractionBox["\[Beta]1", "2"], "+", 
         FractionBox[
          RowBox[{"5", " ", "\[Beta]3"}], "2"]}], ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Beta]1", ",", "0", ",", "\[Beta]3"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "//", "Simplify"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.984378494965458*^9, 3.9843785830587406`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"d45aa5d3-a9f0-2042-9e03-26b2ec90a35c"],

