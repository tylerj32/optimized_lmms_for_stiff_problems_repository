Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s now try Reduce for NMinimize", "Subsubsection",
 CellChangeTimes->{{3.984127461475828*^9, 
  3.984127476019068*^9}},ExpressionUUID->"a5c77d71-bf25-b14e-bf48-\
03b503431a6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trial2", "=", 
   RowBox[{
    RowBox[{"Reduce", "[", 
     RowBox[{
      RowBox[{"{", "cond2beta", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]2", ",", "\[Beta]3"}], "}"}], ",", "Reals"}], "]"}], "//",
     "Simplify"}]}], ";"}]], "Input",
