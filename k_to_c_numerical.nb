Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eps", "=", "0.05"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sets", "=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cond2step", "&&", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Beta]3", "]"}], "<", "eps"}]}], ",", 
       RowBox[{"cond2beta", "&&", 
        RowBox[{
         RowBox[{"Abs", "[", "\[Beta]1", "]"}], "<", "eps"}]}], ",", 
