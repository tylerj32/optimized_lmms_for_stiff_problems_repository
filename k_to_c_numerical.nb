Notebook[{
Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9841201102634983`*^9, 3.9841201136381855`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"3ad8083c-97f5-3a41-8269-e7f05a278feb"],

Cell[CellGroupData[{

Cell["\<\
In this notebook, we will attempt to find out why Minimize and NMinimize \
produce conflicting results, and then have them produce the same results\
\>", "Subsection",
 CellChangeTimes->{{3.984111971170788*^9, 3.984111987468149*^9}, {
  3.9841120742700825`*^9, 
  3.9841121159276733`*^9}},ExpressionUUID->"963f7ac7-e07f-de44-8001-\
de02e81191c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "a_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->
  "In[134]:=",ExpressionUUID->"afb46034-1f23-f649-b705-c9bf602d10a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scenario 1: 2-step LMMs (all \[Beta] coefficients are nonzero)", \
"Subsection",
 CellChangeTimes->{{3.9827412706254215`*^9, 
  3.9827412984105473`*^9}},ExpressionUUID->"787f59ae-a65d-664f-8d7b-\
7d1d1bd673e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond2step", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"2", " ", "\[Beta]2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
            RowBox[{"2", " ", "\[Beta]2"}]}], ")"}]}], "\[LessEqual]", "0"}], 
        "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"4", " ", "\[Beta]2", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
                RowBox[{"3", " ", "\[Beta]2"}]}], ")"}]}], ">", 
             SuperscriptBox["\[Beta]1", "2"]}], "&&", 
            RowBox[{
             RowBox[{"\[Beta]1", "+", 
              RowBox[{"2", " ", "\[Beta]2"}]}], "\[NotEqual]", "2"}]}], ")"}],
           "||", 
          RowBox[{
           RowBox[{"2", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "2"}], "+", "\[Beta]1"}], ")"}], " ", 
             "\[Beta]1"}]}], "\[GreaterEqual]", 
           RowBox[{"4", " ", 
            SuperscriptBox["\[Beta]2", "2"]}]}]}], ")"}], "&&", 
        RowBox[{
         RowBox[{"\[Beta]1", "+", 
          RowBox[{"2", " ", "\[Beta]2"}]}], ">", "1"}]}], ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]2", " ", 
           SuperscriptBox["\[Kappa]", "2"]}], "]"}], ">", 
         RowBox[{"Abs", "[", "\[Beta]0", "]"}]}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           SuperscriptBox["\[Beta]0", "2"], "-", 
           RowBox[{
            SuperscriptBox["\[Beta]2", "2"], " ", 
            SuperscriptBox["\[Kappa]", "4"]}]}], "]"}], ">", 
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]1", " ", "\[Kappa]", " ", 
           RowBox[{"(", 
            RowBox[{"\[Beta]0", "-", 
             RowBox[{"\[Beta]2", " ", 
              SuperscriptBox["\[Kappa]", "2"]}]}], ")"}]}], "]"}]}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[Beta]0", "->", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
        RowBox[{"3", " ", "\[Beta]2"}]}]}], "}"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.982741302912447*^9, 3.9827413044304314`*^9}, {
   3.982744891309969*^9, 3.98274490044223*^9}, {3.9827449645057907`*^9, 
   3.982744979386194*^9}, 3.982823899648157*^9, {3.982824926001028*^9, 
   3.9828249360769444`*^9}, {3.9839496036606903`*^9, 3.983949604321991*^9}, {
   3.9839496921847916`*^9, 3.983949693604517*^9}, 3.9846410029193306`*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"c2c7df8d-27e5-364f-a129-260d53176698"],

Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s see if we can fix the numerical issue via \
Reduce", "Subsubsection",
 CellChangeTimes->{{3.9841273760656414`*^9, 
  3.9841273915798817`*^9}},ExpressionUUID->"3c4e3c03-761f-2b49-9ff1-\
64f4c495c209"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trial", "=", 
   RowBox[{
    RowBox[{"Reduce", "[", 
     RowBox[{
      RowBox[{"{", "cond2step", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "}"}], ",", "Reals"}], "]"}], "//",
     "Simplify"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.984126768117073*^9, 3.984126788139494*^9}, {
  3.984126831274399*^9, 3.9841268441769943`*^9}, {3.9841269068471756`*^9, 
  3.9841269131659393`*^9}, {3.9841269534324455`*^9, 3.9841269628714657`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"ad3dd831-c5f4-c940-86c5-638b383e4069"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c3", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["j", "3"], 
         RowBox[{"a", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
        RowBox[{"3", "!"}]], "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["j", 
          RowBox[{"3", "-", "1"}]], 
         RowBox[{"b", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", 
        RowBox[{
         RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9827452224681416`*^9, 3.9827452268243427`*^9}, {
  3.9828234166762867`*^9, 3.9828234355517616`*^9}, {3.982823474164467*^9, 
  3.982823481154194*^9}, {3.98282357456456*^9, 3.982823590977844*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"3796db81-20a0-354d-9159-c3325100772a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"c3", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "\[Beta]1"}], "-", 
       RowBox[{"4", " ", "\[Beta]2"}]}], ",", 
      RowBox[{
       RowBox[{"-", "4"}], "+", 
       RowBox[{"2", " ", "\[Beta]1"}], "+", 
       RowBox[{"4", " ", "\[Beta]2"}]}], ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
       RowBox[{"3", " ", "\[Beta]2"}]}], ",", "\[Beta]1", ",", "\[Beta]2"}], 
     "}"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9828234867915344`*^9, 3.9828235644961452`*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"31606102-3678-984e-bc47-5e703ca3c4e3"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "12"], " ", 
  RowBox[{"Abs", "[", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
     RowBox[{"8", " ", "\[Beta]2"}]}], 
    RowBox[{
     RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
     RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}]], "Output",
 CellChangeTimes->{{3.9828235831319904`*^9, 3.9828235938831024`*^9}, 
   3.9828243791090755`*^9, {3.983756518313648*^9, 3.9837565336315346`*^9}, 
   3.9839466652189865`*^9, 3.9839496103168697`*^9, 3.984112202454544*^9, 
   3.984120121174612*^9, 3.9843632624931717`*^9, 3.984381178024824*^9, 
   3.9843822929571686`*^9, 3.984641033596077*^9},
 CellLabel->"Out[74]=",ExpressionUUID->"fe90f57f-6fb3-0148-9e2e-e94240882557"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32step", "[", 
   RowBox[{"\[Beta]1_", ",", "\[Beta]2_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"Abs", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
      RowBox[{"8", " ", "\[Beta]2"}]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
      RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98282360214221*^9, 3.9828236189858093`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"ab6a55f9-d9fa-cd4a-a60d-1724514cf1c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"Abs", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
      RowBox[{"8", " ", "\[Beta]2"}]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
      RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}], "//", "TeXForm"}]], "Input",
 CellChangeTimes->{{3.985339055385008*^9, 3.9853390576347904`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"b32731db-3ada-fa4c-bb8d-9ed255526258"],

Cell["\<\
\\frac{1}{12} \\left| \\frac{\\text{$\\beta $1}+8 \\text{$\\beta \
$2}-4}{\\text{$\\beta $1}+2 \\text{$\\beta $2}-1}\\right|\
\>", "Output",
 CellChangeTimes->{3.985339058367201*^9},
 CellLabel->
  "Out[25]//TeXForm=",ExpressionUUID->"c4977a54-ab05-df4f-88a6-a5f12bbd8fdd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Because Mathematica can\[CloseCurlyQuote]t handle plotting this directly, \
we will just make a table and sample points from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"0", " ", "to", " ", "1"}]}], TraditionalForm]],ExpressionUUID->
  "b5eee697-9004-f84a-bff1-4bf42aad2420"]
}], "Subsubsection",
 CellChangeTimes->{{3.982825085918909*^9, 
  3.9828251714930935`*^9}},ExpressionUUID->"56463b47-944f-7c49-8838-\
8d7c419060b1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Kappa]list2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"Minimize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c32step", "[", 
              RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "]"}], ",", 
             RowBox[{"cond2step", "/.", " ", 
              RowBox[{"\[Kappa]", "->", "k"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "1", ",", 
       RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9827449940026627`*^9, {3.982745105996086*^9, 3.9827451579631405`*^9}, 
   3.9828233517283688`*^9, {3.982823632518505*^9, 3.982823659803295*^9}, 
   3.9828239070820217`*^9, 3.982824956374914*^9},
 CellLabel->"In[41]:=",ExpressionUUID->"68cc3368-765d-5349-a7e9-acafecdfba6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "!=", "0"}], TraditionalForm]],ExpressionUUID->
  "efd0137e-6782-364a-9dc9-db88fa4b6f8e"],
 ", we will artificially add that in, as it corresponds to the BDF2 method"
}], "Subsubsection",
 CellChangeTimes->{{3.982825226385988*^9, 
  3.98282527208712*^9}},ExpressionUUID->"403b52bb-089e-0142-a061-\
79baf506c847"],

