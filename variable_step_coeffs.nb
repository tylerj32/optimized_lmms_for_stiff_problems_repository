Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "In this notebook we will derive the variable step size ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "346b3511-e552-294b-9241-1e7dd95c27ab"],
 " (and hopefully also ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL4", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a1bffef-15db-f042-aa34-c4464fc167c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["5", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38615a86-ca5a-6741-8d5f-a9b8404c936d"],
 ") via the interpolating method"
}], "Subsection",
 CellChangeTimes->{{3.989463005113493*^9, 
  3.9894630592016144`*^9}},ExpressionUUID->"45b1d0fa-6f9b-9748-a57e-\
f737f1ac1e65"],

Cell[CellGroupData[{

Cell["\<\
As a test run, we will derive the BDF2 method with the approach of Arevalo \
and Soderlind\
\>", "Subsubsection",
 CellChangeTimes->{{3.989463169732918*^9, 
  3.9894632161740665`*^9}},ExpressionUUID->"24cbeaf9-4e0d-a34b-b85f-\
1ac98c40989b"],

Cell[CellGroupData[{

