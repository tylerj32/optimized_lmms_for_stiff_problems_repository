Cell[BoxData[
 RowBox[{
  RowBox[{"variablestepcond", "[", 
   RowBox[{"p_", ",", "k_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Alpha]", 
           RowBox[{"n", ",", "j"}]], " ", 
          SuperscriptBox[
           RowBox[{"c", "[", 
            RowBox[{"j", ",", "k"}], "]"}], 
           RowBox[{"m", "+", "\[CurlyEpsilon]"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}], "==", 
       RowBox[{"m", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Beta]", 
            RowBox[{"n", ",", "j"}]], " ", 
           SuperscriptBox[
            RowBox[{"c", "[", 
             RowBox[{"j", ",", "k"}], "]"}], 
            RowBox[{"m", "-", "1", "+", "\[CurlyEpsilon]"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}]}]}], ")"}], ",", 
