Cell[CellGroupData[{

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", "n"], ")"}], TraditionalForm]],ExpressionUUID->
  "0cff6161-ffc0-0e46-9cb5-075f527aa53b"],
 " be some polynomial at time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "n"], TraditionalForm]],ExpressionUUID->
  "229e6ca8-bf57-8a41-8522-f9e8d55e655c"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    RowBox[{"f", "(", 
     RowBox[{
      SubscriptBox["t", "n"], ",", 
      RowBox[{"P", "(", 
       SubscriptBox["t", "n"], ")"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"aeb1c9c4-1ed1-7249-a90e-f9ee3a0f243e"],
 " \t\t(a)\nWe add these conditions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["s", 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{"cos", "(", 
       SubscriptBox["\[Theta]", "0"], ")"}]}], "+", 
     RowBox[{"h", " ", 
      SubscriptBox[
       RowBox[{"s", "'"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{"sin", "(", 
       SubscriptBox["\[Theta]", "0"], ")"}]}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"afa093af-9b2a-7841-ba7b-7f4a4d8c84fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["s", 
       RowBox[{"n", "-", "2"}]], 
      RowBox[{"cos", "(", 
       SubscriptBox["\[Theta]", "1"], ")"}]}], "+", 
     RowBox[{"h", " ", 
      SubscriptBox[
       RowBox[{"s", "'"}], 
       RowBox[{"n", "-", "2"}]], 
      RowBox[{"sin", "(", 
       SubscriptBox["\[Theta]", "1"], ")"}]}]}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"f21bb8c8-9cd1-8a45-b66e-c8a82f19e66c"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "n"], "=", 
    RowBox[{
     RowBox[{"P", "(", 
      SubscriptBox["t", "n"], ")"}], "-", 
     SubscriptBox["y", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "8e63015a-bc72-014c-afc3-ee14df3aecf4"],
 "\nWe have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"tan", "(", "\[Theta]", ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"sin", "(", "\[Theta]", ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"cos", "(", "\[Theta]", ")"}], "=", "1"}]}], TraditionalForm]],
  ExpressionUUID->"d58b23ad-1e94-d14c-a8cb-071a434ce93f"],
 ". Plugging this into the two previous equations we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", 
     RowBox[{"n", "-", "1"}]], "=", 
    RowBox[{
     RowBox[{"0", " ", "and", " ", 
      SubscriptBox["s", 
       RowBox[{"n", "-", "2"}]]}], "=", "0"}]}], TraditionalForm]],
  ExpressionUUID->"8203547c-671c-b945-9a25-96500b63a36f"],
 ".\nThis means ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "d00a19ce-4d57-f742-b1eb-aad2c729219e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "df6a9815-e756-a04a-80f8-9ba4a04aa0a7"],
 ". Let\[CloseCurlyQuote]s call these equations (b) and (c), respectively.\n\
These conditions determine a polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "2e1c4c18-90d2-e949-9546-bf9df2851444"],
 " (quadratic). Then the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", "n"], ")"}], TraditionalForm]],ExpressionUUID->
  "a570e007-cdaa-b744-8d81-a41b206b250b"],
 " gives the updated solution.\nFor convenience, we write the polynomial in \
the form:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", 
    RowBox[{"a", "+", 
     SuperscriptBox[
      RowBox[{"b", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], 
      SubscriptBox["F", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a47faf6e-4e39-da4e-8a50-72e59a816119"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    SubscriptBox["F", "n"]}], TraditionalForm]],ExpressionUUID->
  "9c492d34-e478-5b47-af79-b5d3c63fdf5b"],
 "\nWe then solve for (a)-(c), with the notation that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "n"], "=", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], "+", 
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "4a9330ab-deec-6a4c-9ad8-1c657720aa59"],
 ":\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"fe6ed7d4-9b38-6e40-a4e3-1dc415cda077"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    RowBox[{
     RowBox[{"a", "+", 
      RowBox[{
       SubsuperscriptBox["h", 
        RowBox[{"n", "-", "1"}], "2"], "b"}], "-", 
      RowBox[{
       SubscriptBox["h", 
        RowBox[{"n", "-", "1"}]], 
       SubscriptBox["F", "n"]}]}], "\[Equivalent]", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "828baa18-d0c3-bc4c-b880-e470b819f97f"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    RowBox[{
     RowBox[{"a", "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["h", 
           RowBox[{"n", "-", "2"}]], "+", 
          SubscriptBox["h", 
           RowBox[{"n", "-", "1"}]]}], ")"}], "2"], "b"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], "+", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}], ")"}], 
       SubscriptBox["F", "n"]}]}], "\[Equivalent]", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]]}]}], TraditionalForm]],ExpressionUUID->
  "79410782-695b-af46-9fa4-b7c55309305f"],
 "\nLet\[CloseCurlyQuote]s now take the difference of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]], "-", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "8c0f0ed6-df31-6b40-a8c0-80ec1a18c424"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"b", "(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["h", 
         RowBox[{"n", "-", "2"}]], 
        SubscriptBox["h", 
         RowBox[{"n", "-", "1"}]]}], "+", 
       SubsuperscriptBox["h", 
        RowBox[{"n", "-", "2"}], "2"]}], ")"}], "-", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "2"}]], 
      SubscriptBox["F", "n"]}]}], "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]], "-", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],ExpressionUUID->
  "b16f6485-f06b-eb43-8c31-28f0fa4b7306"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    FractionBox[
     RowBox[{
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]], "-", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]], "+", 
      RowBox[{
       SubscriptBox["h", 
        RowBox[{"n", "-", "2"}]], 
       SubscriptBox["F", "n"]}]}], 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "2"}], "2"], "+", 
      RowBox[{"2", 
       SubscriptBox["h", 
        RowBox[{"n", "-", "2"}]], 
       SubscriptBox["h", 
        RowBox[{"n", "-", "1"}]]}]}]]}], TraditionalForm]],ExpressionUUID->
  "a1b01fcb-4c43-e748-9fb7-297d208ed9f4"],
 "\nNote that from the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "1"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "55d40470-8324-4a45-ae6f-f577007d3ede"],
 " equation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}], "-", 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "1"}], "2"], "b"}]}]}], TraditionalForm]],
  ExpressionUUID->"f10f68aa-1557-044e-adbe-840078d3aec6"],
 "\nTherefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}], "-", 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "1"}], "2"], "(", 
      FractionBox[
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"n", "-", "2"}]], "-", 
        SubscriptBox["y", 
         RowBox[{"n", "-", "1"}]], "+", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["F", "n"]}]}], 
       RowBox[{
        SubsuperscriptBox["h", 
         RowBox[{"n", "-", "2"}], "2"], "+", 
        RowBox[{"2", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}]}]], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"29ac1ddc-5513-3a44-9587-eb6e9a7ffa66"],
 "\nIf we assume a constant step size case: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     RowBox[{"n", "-", "1"}]], "=", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]], "=", "h"}]}], TraditionalForm]],
  ExpressionUUID->"056dc3ba-a454-8646-af23-480f69af060b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]], "+", 
      RowBox[{"h", " ", 
       SubscriptBox["F", "n"]}], "-", 
      RowBox[{
       FractionBox["1", "3"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["y", 
          RowBox[{"n", "-", "2"}]], "-", 
         SubscriptBox["y", 
          RowBox[{"n", "-", "1"}]], "+", 
         RowBox[{"h", " ", 
          SubscriptBox["F", "n"]}]}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["4", "3"], 
       SubscriptBox["y", 
        RowBox[{"n", "-", "1"}]]}], "-", 
      RowBox[{
       FractionBox["1", "3"], 
       SubscriptBox["y", 
        RowBox[{"n", "-", "2"}]]}], "+", 
      RowBox[{
       FractionBox["2", "3"], "h", " ", 
       SubscriptBox["F", "n"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "0df71995-c84b-1a40-9265-badfab54d38d"],
 "\nIf we let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    SubscriptBox["y", "n"]}], TraditionalForm]],ExpressionUUID->
  "c85b96df-3b15-ae45-979d-09cff125e06e"],
 ", then we have the BDF2 method\nLet\[CloseCurlyQuote]s also make sure that \
we got the correct variable step size BDF2. Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "n"], "=", 
    FractionBox[
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]], 
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]]]}], TraditionalForm]],ExpressionUUID->
  "827d9c30-0b10-9a49-b07a-0fc25811955d"],
 "."
}], "Subsubsection",
 CellChangeTimes->{{3.9894632526256332`*^9, 3.9894635251478233`*^9}, {
  3.9894635840338726`*^9, 3.9894639103799*^9}, {3.98946397647838*^9, 
  3.989464015665661*^9}, {3.9894640464789047`*^9, 3.989464227358879*^9}, {
  3.9894644739630375`*^9, 3.9894645112651844`*^9}, {3.98946579147665*^9, 
  3.989466230010271*^9}, {3.9894663423491*^9, 3.989466422639944*^9}, {
  3.989466527500288*^9, 3.9894665989349556`*^9}, {3.989466673819908*^9, 
  3.9894666992331276`*^9}, {3.9894672777491417`*^9, 3.9894672780799923`*^9}, {
  3.98946754236092*^9, 
  3.9894675621446457`*^9}},ExpressionUUID->"8c485a3c-2963-3b42-a2f6-\
9b20abca13a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]], "+", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]], 
     SubscriptBox["F", "n"]}], "-", 
    RowBox[{
     SubsuperscriptBox["h", 
      RowBox[{"n", "-", "1"}], "2"], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"n", "-", "2"}]], "-", 
        SubscriptBox["y", 
         RowBox[{"n", "-", "1"}]], "+", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["F", "n"]}]}], 
       RowBox[{
        SubsuperscriptBox["h", 
         RowBox[{"n", "-", "2"}], "2"], "+", 
        RowBox[{"2", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}]}]], ")"}]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]], "->", 
     FractionBox[
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["\[Omega]", "n"]]}], "}"}]}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.989466478141342*^9, 3.989466485056011*^9}, {
  3.989466522581848*^9, 3.989466524477871*^9}, {3.9894667078599834`*^9, 
  3.9894667202001705`*^9}, {3.989466750337124*^9, 3.989466841321913*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"06c9cef8-0e35-1540-9b9f-8a17f9072fc4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["y", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "n"}]]}], " ", 
    SubsuperscriptBox["\[Omega]", "n", "2"]}], "+", 
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    SubscriptBox["h", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox["\[Omega]", "n"]}], ")"}]}], "+", 
   RowBox[{
    SubscriptBox["y", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}]}], 
  RowBox[{"1", "+", 
   RowBox[{"2", " ", 
    SubscriptBox["\[Omega]", "n"]}]}]]], "Output",
 CellChangeTimes->{3.9894668424210033`*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"1dce7d3e-6203-ad47-8c24-ad57705b1012"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["y", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "n"}]]}], " ", 
      SubsuperscriptBox["\[Omega]", "n", "2"]}], "+", 
     RowBox[{
      SubscriptBox["F", "n"], " ", 
      SubscriptBox["h", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SubscriptBox["\[Omega]", "n"]}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["y", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}]}], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Omega]", "n"]}]}]], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]], ",", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], ",", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9894668597233963`*^9, 3.989466903196249*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"5972b4e0-e0f1-6743-9d47-15e8f7fddcde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SubscriptBox["y", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "n"}]], " ", 
     SubsuperscriptBox["\[Omega]", "n", "2"]}], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Omega]", "n"]}]}]]}], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    SubscriptBox["h", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox["\[Omega]", "n"]}], ")"}]}], 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Omega]", "n"]}]}]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["y", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}], 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Omega]", "n"]}]}]]}]], "Output",
 CellChangeTimes->{3.9894669041177864`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"5a2b1a2c-0ecc-e144-91a3-0108b9e5abdd"]
}, Open  ]]
}, Open  ]],

Cell["\<\
These coefficients above match the ones found in HNW I, Section III.5 (page \
401)\
\>", "Subsubsection",
 CellChangeTimes->{{3.989467068461218*^9, 
  3.989467098258066*^9}},ExpressionUUID->"a7e4d6bd-4478-354c-b4e5-\
d72363a21144"],

Cell[TextData[{
 "Now we want to find ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],ExpressionUUID->
  "1ab8d15e-03fb-7648-91d6-c1ad36730ce0"],
 ". This is a 3-step, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "nd"], TraditionalForm]],ExpressionUUID->
  "fd23d22d-1d3b-a345-b02f-cd7a1c409478"],
 " order LMM. We therefore need to impose 3 conditions to determine the \
method. We will therefore impose this generalization:\nThe degree of P \
corresponds to the order of the method\nOne condition is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    SubscriptBox["F", "n"]}], TraditionalForm]],ExpressionUUID->
  "d0f4eac0-cd0f-0e4c-869d-19c9d57c73e6"],
 "          (1)\nThe other two conditions will come from two independent \
linear combinations of:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "3"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "3"}]]}], TraditionalForm]}],ExpressionUUID->
  "ce8574ef-5dbe-e94b-b476-cf2b451f1aa0"],
 "\n\nTo make this happen, say we have:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]", " ", 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "1"}]], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Theta]"}], ")"}], 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "2"}]], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"\[Theta]", " ", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Theta]"}], ")"}], 
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]], "               ", 
      RowBox[{"(", "2", ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "2"}]], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Gamma]"}], ")"}], 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "3"}]], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Gamma]"}], ")"}], 
      SubscriptBox["y", 
       RowBox[{"n", "-", "3"}]], "               ", 
      RowBox[{"(", "3", ")"}]}]}]}], TraditionalForm]}],ExpressionUUID->
  "88258605-fd98-7e48-bbe5-71bcf9dfc649"],
 "\nWe also let:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", 
    RowBox[{"a", "+", 
     SuperscriptBox[
      RowBox[{"b", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], 
      SubscriptBox["F", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "9052b5d2-48fb-784c-8c1e-6348eba5b84f"],
 "\nThis allows once again ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"38ce3b1f-e845-ff4b-9e8e-c1bd2388dedc"],
 "\nWe then solve (1)-(3) for the value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"1e83b697-7389-d041-ae84-e6ec525bd006"],
 ", then choose \[Theta] and \[Gamma] such that the formula for ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "4ad8cdac-e1e6-434e-8837-8ef997b2a80b"],
 " matches ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],ExpressionUUID->
  "4ae10b96-cf70-5b43-8bff-0f981d8de426"],
 " for fixed step size. We then expand it into variable step size using the \
values of \[Theta] and \[Gamma]"
}], "Subsubsection",
 CellChangeTimes->{{3.9894679506381454`*^9, 3.9894683753016415`*^9}, {
  3.9894684409838314`*^9, 3.98946854751437*^9}, {3.9894686219616566`*^9, 
  3.9894688689184837`*^9}, {3.989468900073799*^9, 
  3.9894690086487446`*^9}},ExpressionUUID->"818ba1af-183f-5141-9ab4-\
76b1bdc5279d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Let\[CloseCurlyQuote]s set up the formula for this. For the input code, \
note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "(", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]], ")"}], "=", "Ptn1"}], ",", " ", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "=", "yn1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "400da0c1-3905-8f46-bff9-e81e0301931c"],
 ", and so forth"
}], "Subsubsection",
 CellChangeTimes->{{3.9894690254034233`*^9, 3.989469033821432*^9}, {
  3.9894690958346786`*^9, 
  3.989469147548029*^9}},ExpressionUUID->"42d044e4-c469-df4b-a5b5-\
4238402207e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", " ", "Ptn1"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Theta]"}], ")"}], "Ptn2"}]}], "==", 
     RowBox[{
      RowBox[{"\[Theta]", " ", "yn1"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Theta]"}], ")"}], "yn2"}]}]}], ",", "Ptn1"}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.989469066602619*^9, 3.9894690927293587`*^9}, {
  3.9894691709103737`*^9, 3.989469215806637*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"0c685a55-1dc6-bc4c-bf3d-17cb23192795"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"Ptn1", "\[Rule]", 
    RowBox[{"yn1", "+", 
     RowBox[{"yn2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
     FractionBox[
      RowBox[{"Ptn2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Theta]"}], ")"}]}], "\[Theta]"]}]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.989469206938175*^9, 3.989469216199358*^9}},
 CellLabel->"Out[4]=",ExpressionUUID->"2a11f3a3-b0b0-104e-87f6-a83832d663ef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Note that this means that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"yn2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
   FractionBox[
    RowBox[{"Ptn2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Theta]"}], ")"}]}], "\[Theta]"]}]],
  CellChangeTimes->{{3.989469206938175*^9, 3.989469216199358*^9}},
  ExpressionUUID->"1929fa04-01cb-b840-958a-0b4292e49560"],
 " must equal 0"
}], "Subsubsection",
 CellChangeTimes->{{3.989469251375513*^9, 3.989469263933401*^9}, {
  3.9894693201713448`*^9, 
  3.9894693247422657`*^9}},ExpressionUUID->"d0b5dc91-af42-0e47-8d98-\
c9a6d78ab352"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"yn2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
      FractionBox[
       RowBox[{"Ptn2", " ", 
        RowBox[{"(", 
         RowBox[{
