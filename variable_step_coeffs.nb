Cell["\<\
F_n \\left(-\\frac{\\theta  h_{n-1}^2}{h_{n-3}+2 \
\\left(h_{n-2}+h_{n-1}\\right)}+\\theta  h_{n-1}+(1-\\theta )
   \\left(h_{n-2}+h_{n-1}\\right)+\\frac{(\\theta -1) \
\\left(h_{n-2}+h_{n-1}\\right){}^2}{h_{n-3}+2 \\left(h_{n-2}+h_{n-1}\\right)}\
\\right)+y_{n-3}
   \\left(\\frac{(\\theta -1) \\left(h_{n-2}+h_{n-1}\\right){}^2}{h_{n-3} \
\\left(h_{n-3}+2 \\left(h_{n-2}+h_{n-1}\\right)\\right)}-\\frac{\\theta 
   h_{n-1}^2}{h_{n-3} \\left(h_{n-3}+2 \
\\left(h_{n-2}+h_{n-1}\\right)\\right)}\\right)+y_{n-2} \\left(\\frac{\\theta \
 h_{n-1}^2}{h_{n-3} \\left(h_{n-3}+2
   \\left(h_{n-2}+h_{n-1}\\right)\\right)}+\\frac{(1-\\theta ) \
\\left(h_{n-2}+h_{n-1}\\right){}^2}{h_{n-3} \\left(h_{n-3}+2
   \\left(h_{n-2}+h_{n-1}\\right)\\right)}-\\theta +1\\right)+\\theta  y_{n-1}\
\>", "Output",
