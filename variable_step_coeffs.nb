Cell[TextData[{
 "FYI, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3812f932-4486-914a-b5ce-81d8410e49c8"],
 " in this setup can be simplified to -2/3"
}], "Subsubsection",
 CellChangeTimes->{{3.9894838247956486`*^9, 
  3.989483859034399*^9}},ExpressionUUID->"a0e31c4e-1b75-3449-96e2-\
4076be036048"],

Cell[CellGroupData[{

Cell[TextData[{
 "Our list of \[Alpha] coefficients is now, starting with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "0"], TraditionalForm]],ExpressionUUID->
  "b7fb47d8-c273-2142-93b7-9cecef28fecc"],
 ": ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{" ", 
        RowBox[{
         SubsuperscriptBox["\[Omega]", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", 
            SubscriptBox["\[Omega]", "n"]}], "-", 
           RowBox[{"2", " ", 
            SubsuperscriptBox["\[Omega]", "n", "2"]}]}], ")"}]}]}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           SubscriptBox["\[Omega]", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", "n"]}], ")"}]}]}], ")"}]}]]}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", 
          SubscriptBox["\[Omega]", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SubscriptBox["\[Omega]", "n"]}], ")"}]}], "+", 
         RowBox[{
          SubsuperscriptBox["\[Omega]", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}], "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "-", 
            RowBox[{"2", " ", 
             SubscriptBox["\[Omega]", "n"]}], "+", 
            RowBox[{"2", " ", 
             SubsuperscriptBox["\[Omega]", "n", "2"]}]}], ")"}]}]}], ")"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           SubscriptBox["\[Omega]", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", "n"]}], ")"}]}]}], ")"}]}]]}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"6", " ", 
          SubscriptBox["\[Omega]", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SubscriptBox["\[Omega]", "n"]}], ")"}]}]}], ")"}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           SubscriptBox["\[Omega]", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "n"}]], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", "n"]}], ")"}]}]}], ")"}]}]]}], ",", 
     "1"}], "}"}], TraditionalForm]],ExpressionUUID->
  "5635bea7-3001-f34f-b72c-5cf4f4d10ee4"],
 "; and \[Beta]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", " ", 
         SubscriptBox["\[Omega]", "n"]}], "+", 
        RowBox[{
         SubscriptBox["\[Omega]", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}]], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"4", " ", 
            SubscriptBox["\[Omega]", "n"]}], "+", 
           RowBox[{"2", " ", 
            SubsuperscriptBox["\[Omega]", "n", "2"]}]}], ")"}]}]}], ")"}], 
      RowBox[{"2", " ", 
       SubscriptBox["\[Omega]", "n"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", 
          SubscriptBox["\[Omega]", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "n"}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SubscriptBox["\[Omega]", "n"]}], ")"}]}]}], ")"}]}]]}], "}"}], 
   TraditionalForm]],ExpressionUUID->"29e28897-dd24-c745-b37c-111b287c3dff"],
 "\nSince this should be ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "nd"], TraditionalForm]],ExpressionUUID->
  "2168125e-98cd-724f-8902-5626825e18d3"],
 " order, we will impose the variable step conditions directly on this set of \
coefficients and see if my order conditions work"
}], "Subsubsection",
 CellChangeTimes->{{3.9894774702722282`*^9, 3.989477636226822*^9}, {
