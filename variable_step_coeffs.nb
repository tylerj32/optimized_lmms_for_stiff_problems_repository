(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "In this notebook we will derive the variable step size ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "346b3511-e552-294b-9241-1e7dd95c27ab"],
 " (and hopefully also ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL4", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a1bffef-15db-f042-aa34-c4464fc167c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["5", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38615a86-ca5a-6741-8d5f-a9b8404c936d"],
 ") via the interpolating method"
}], "Subsection",
 CellChangeTimes->{{3.989463005113493*^9, 
  3.9894630592016144`*^9}},ExpressionUUID->"45b1d0fa-6f9b-9748-a57e-\
f737f1ac1e65"],

Cell["\<\
As a test run, we will derive the BDF2 method with the approach of Arevalo \
and Soderlind\
\>", "Subsubsection",
 CellChangeTimes->{{3.989463169732918*^9, 
  3.9894632161740665`*^9}},ExpressionUUID->"24cbeaf9-4e0d-a34b-b85f-\
1ac98c40989b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", "n"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0cff6161-ffc0-0e46-9cb5-075f527aa53b"],
 " be some polynomial at time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "n"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "229e6ca8-bf57-8a41-8522-f9e8d55e655c"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    RowBox[{"f", "(", 
     RowBox[{
      SubscriptBox["t", "n"], ",", 
      RowBox[{"P", "(", 
       SubscriptBox["t", "n"], ")"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aeb1c9c4-1ed1-7249-a90e-f9ee3a0f243e"],
 " \t\t(a)\nWe add these conditions: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["s", 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{"cos", "(", 
       SubscriptBox["\[Theta]", "0"], ")"}]}], "+", 
     RowBox[{"h", " ", 
      SubscriptBox[
       RowBox[{"s", "'"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{"sin", "(", 
       SubscriptBox["\[Theta]", "0"], ")"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "afa093af-9b2a-7841-ba7b-7f4a4d8c84fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["s", 
       RowBox[{"n", "-", "2"}]], 
      RowBox[{"cos", "(", 
       SubscriptBox["\[Theta]", "1"], ")"}]}], "+", 
     RowBox[{"h", " ", 
      SubscriptBox[
       RowBox[{"s", "'"}], 
       RowBox[{"n", "-", "2"}]], 
      RowBox[{"sin", "(", 
       SubscriptBox["\[Theta]", "1"], ")"}]}]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f21bb8c8-9cd1-8a45-b66e-c8a82f19e66c"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "n"], "=", 
    RowBox[{
     RowBox[{"P", "(", 
      SubscriptBox["t", "n"], ")"}], "-", 
     SubscriptBox["y", "n"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e63015a-bc72-014c-afc3-ee14df3aecf4"],
 "\nWe have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"tan", "(", "\[Theta]", ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"sin", "(", "\[Theta]", ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"cos", "(", "\[Theta]", ")"}], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d58b23ad-1e94-d14c-a8cb-071a434ce93f"],
 ". Plugging this into the two previous equations we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", 
     RowBox[{"n", "-", "1"}]], "=", 
    RowBox[{
     RowBox[{"0", " ", "and", " ", 
      SubscriptBox["s", 
       RowBox[{"n", "-", "2"}]]}], "=", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8203547c-671c-b945-9a25-96500b63a36f"],
 ".\nThis means ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d00a19ce-4d57-f742-b1eb-aad2c729219e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "df6a9815-e756-a04a-80f8-9ba4a04aa0a7"],
 ". Let\[CloseCurlyQuote]s call these equations (b) and (c), respectively.\n\
These conditions determine a polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e1c4c18-90d2-e949-9546-bf9df2851444"],
 " (quadratic). Then the value ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", "n"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a570e007-cdaa-b744-8d81-a41b206b250b"],
 " gives the updated solution.\nFor convenience, we write the polynomial in \
the form:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", 
    RowBox[{"a", "+", 
     SuperscriptBox[
      RowBox[{"b", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], 
      SubscriptBox["F", "n"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a47faf6e-4e39-da4e-8a50-72e59a816119"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    SubscriptBox["F", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c492d34-e478-5b47-af79-b5d3c63fdf5b"],
 "\nWe then solve for (a)-(c), with the notation that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "n"], "=", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], "+", 
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a9330ab-deec-6a4c-9ad8-1c657720aa59"],
 ":\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe6ed7d4-9b38-6e40-a4e3-1dc415cda077"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    RowBox[{
     RowBox[{"a", "+", 
      RowBox[{
       SubsuperscriptBox["h", 
        RowBox[{"n", "-", "1"}], "2"], "b"}], "-", 
      RowBox[{
       SubscriptBox["h", 
        RowBox[{"n", "-", "1"}]], 
       SubscriptBox["F", "n"]}]}], "\[Equivalent]", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "828baa18-d0c3-bc4c-b880-e470b819f97f"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    RowBox[{
     RowBox[{"a", "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["h", 
           RowBox[{"n", "-", "2"}]], "+", 
          SubscriptBox["h", 
           RowBox[{"n", "-", "1"}]]}], ")"}], "2"], "b"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], "+", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}], ")"}], 
       SubscriptBox["F", "n"]}]}], "\[Equivalent]", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79410782-695b-af46-9fa4-b7c55309305f"],
 "\nLet\[CloseCurlyQuote]s now take the difference of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]], "-", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c0f0ed6-df31-6b40-a8c0-80ec1a18c424"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"b", "(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["h", 
         RowBox[{"n", "-", "2"}]], 
        SubscriptBox["h", 
         RowBox[{"n", "-", "1"}]]}], "+", 
       SubsuperscriptBox["h", 
        RowBox[{"n", "-", "2"}], "2"]}], ")"}], "-", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "2"}]], 
      SubscriptBox["F", "n"]}]}], "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]], "-", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b16f6485-f06b-eb43-8c31-28f0fa4b7306"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    FractionBox[
     RowBox[{
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]], "-", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]], "+", 
      RowBox[{
       SubscriptBox["h", 
        RowBox[{"n", "-", "2"}]], 
       SubscriptBox["F", "n"]}]}], 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "2"}], "2"], "+", 
      RowBox[{"2", 
       SubscriptBox["h", 
        RowBox[{"n", "-", "2"}]], 
       SubscriptBox["h", 
        RowBox[{"n", "-", "1"}]]}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1b01fcb-4c43-e748-9fb7-297d208ed9f4"],
 "\nNote that from the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "1"}]], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55d40470-8324-4a45-ae6f-f577007d3ede"],
 " equation, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}], "-", 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "1"}], "2"], "b"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f10f68aa-1557-044e-adbe-840078d3aec6"],
 "\nTherefore, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "+", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}], "-", 
     RowBox[{
      SubsuperscriptBox["h", 
       RowBox[{"n", "-", "1"}], "2"], "(", 
      FractionBox[
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"n", "-", "2"}]], "-", 
        SubscriptBox["y", 
         RowBox[{"n", "-", "1"}]], "+", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["F", "n"]}]}], 
       RowBox[{
        SubsuperscriptBox["h", 
         RowBox[{"n", "-", "2"}], "2"], "+", 
        RowBox[{"2", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}]}]], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29ac1ddc-5513-3a44-9587-eb6e9a7ffa66"],
 "\nIf we assume a constant step size case: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", 
     RowBox[{"n", "-", "1"}]], "=", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]], "=", "h"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "056dc3ba-a454-8646-af23-480f69af060b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]], "+", 
      RowBox[{"h", " ", 
       SubscriptBox["F", "n"]}], "-", 
      RowBox[{
       FractionBox["1", "3"], 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["y", 
          RowBox[{"n", "-", "2"}]], "-", 
         SubscriptBox["y", 
          RowBox[{"n", "-", "1"}]], "+", 
         RowBox[{"h", " ", 
          SubscriptBox["F", "n"]}]}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       FractionBox["4", "3"], 
       SubscriptBox["y", 
        RowBox[{"n", "-", "1"}]]}], "-", 
      RowBox[{
       FractionBox["1", "3"], 
       SubscriptBox["y", 
        RowBox[{"n", "-", "2"}]]}], "+", 
      RowBox[{
       FractionBox["2", "3"], "h", " ", 
       SubscriptBox["F", "n"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0df71995-c84b-1a40-9265-badfab54d38d"],
 "\nIf we let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    SubscriptBox["y", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c85b96df-3b15-ae45-979d-09cff125e06e"],
 ", then we have the BDF2 method\nLet\[CloseCurlyQuote]s also make sure that \
we got the correct variable step size BDF2. Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "n"], "=", 
    FractionBox[
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]], 
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "827d9c30-0b10-9a49-b07a-0fc25811955d"],
 "."
}], "Subsubsection",
 CellChangeTimes->{{3.9894632526256332`*^9, 3.9894635251478233`*^9}, {
  3.9894635840338726`*^9, 3.9894639103799*^9}, {3.98946397647838*^9, 
  3.989464015665661*^9}, {3.9894640464789047`*^9, 3.989464227358879*^9}, {
  3.9894644739630375`*^9, 3.9894645112651844`*^9}, {3.98946579147665*^9, 
  3.989466230010271*^9}, {3.9894663423491*^9, 3.989466422639944*^9}, {
  3.989466527500288*^9, 3.9894665989349556`*^9}, {3.989466673819908*^9, 
  3.9894666992331276`*^9}, {3.9894672777491417`*^9, 3.9894672780799923`*^9}, {
  3.98946754236092*^9, 
  3.9894675621446457`*^9}},ExpressionUUID->"8c485a3c-2963-3b42-a2f6-\
9b20abca13a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]], "+", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]], 
     SubscriptBox["F", "n"]}], "-", 
    RowBox[{
     SubsuperscriptBox["h", 
      RowBox[{"n", "-", "1"}], "2"], 
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        SubscriptBox["y", 
         RowBox[{"n", "-", "2"}]], "-", 
        SubscriptBox["y", 
         RowBox[{"n", "-", "1"}]], "+", 
        RowBox[{
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["F", "n"]}]}], 
       RowBox[{
        SubsuperscriptBox["h", 
         RowBox[{"n", "-", "2"}], "2"], "+", 
        RowBox[{"2", 
         SubscriptBox["h", 
          RowBox[{"n", "-", "2"}]], 
         SubscriptBox["h", 
          RowBox[{"n", "-", "1"}]]}]}]], ")"}]}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["h", 
      RowBox[{"n", "-", "2"}]], "->", 
     FractionBox[
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["\[Omega]", "n"]]}], "}"}]}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.989466478141342*^9, 3.989466485056011*^9}, {
  3.989466522581848*^9, 3.989466524477871*^9}, {3.9894667078599834`*^9, 
  3.9894667202001705`*^9}, {3.989466750337124*^9, 3.989466841321913*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"06c9cef8-0e35-1540-9b9f-8a17f9072fc4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["y", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "n"}]]}], " ", 
    SubsuperscriptBox["\[Omega]", "n", "2"]}], "+", 
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    SubscriptBox["h", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox["\[Omega]", "n"]}], ")"}]}], "+", 
   RowBox[{
    SubscriptBox["y", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}]}], 
  RowBox[{"1", "+", 
   RowBox[{"2", " ", 
    SubscriptBox["\[Omega]", "n"]}]}]]], "Output",
 CellChangeTimes->{3.9894668424210033`*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"1dce7d3e-6203-ad47-8c24-ad57705b1012"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["y", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "n"}]]}], " ", 
      SubsuperscriptBox["\[Omega]", "n", "2"]}], "+", 
     RowBox[{
      SubscriptBox["F", "n"], " ", 
      SubscriptBox["h", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SubscriptBox["\[Omega]", "n"]}], ")"}]}], "+", 
     RowBox[{
      SubscriptBox["y", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}]}], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Omega]", "n"]}]}]], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "2"}]], ",", 
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], ",", 
     RowBox[{
      SubscriptBox["h", 
       RowBox[{"n", "-", "1"}]], 
      SubscriptBox["F", "n"]}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9894668597233963`*^9, 3.989466903196249*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"5972b4e0-e0f1-6743-9d47-15e8f7fddcde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SubscriptBox["y", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "n"}]], " ", 
     SubsuperscriptBox["\[Omega]", "n", "2"]}], 
    RowBox[{"1", "+", 
     RowBox[{"2", " ", 
      SubscriptBox["\[Omega]", "n"]}]}]]}], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    SubscriptBox["h", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SubscriptBox["\[Omega]", "n"]}], ")"}]}], 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Omega]", "n"]}]}]], "+", 
  FractionBox[
   RowBox[{
    SubscriptBox["y", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SubscriptBox["\[Omega]", "n"]}], ")"}], "2"]}], 
   RowBox[{"1", "+", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Omega]", "n"]}]}]]}]], "Output",
 CellChangeTimes->{3.9894669041177864`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"5a2b1a2c-0ecc-e144-91a3-0108b9e5abdd"]
}, Open  ]]
}, Open  ]],

Cell["\<\
These coefficients above match the ones found in HNW I, Section III.5 (page \
401)\
\>", "Subsubsection",
 CellChangeTimes->{{3.989467068461218*^9, 
  3.989467098258066*^9}},ExpressionUUID->"a7e4d6bd-4478-354c-b4e5-\
d72363a21144"],

Cell[TextData[{
 "Now we want to find ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1ab8d15e-03fb-7648-91d6-c1ad36730ce0"],
 ". This is a 3-step, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "nd"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd23d22d-1d3b-a345-b02f-cd7a1c409478"],
 " order LMM. We therefore need to impose 3 conditions to determine the \
method. We will therefore impose this generalization:\nThe degree of P \
corresponds to the order of the method\nOne condition is that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "'"}], 
     RowBox[{"(", 
      SubscriptBox["t", "n"], ")"}]}], "=", 
    SubscriptBox["F", "n"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d0f4eac0-cd0f-0e4c-869d-19c9d57c73e6"],
 "          (1)\nThe other two conditions will come from two independent \
linear combinations of:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "1"}]]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "2"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "2"}]]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", 
      RowBox[{"n", "-", "3"}]], ")"}], "=", 
    SubscriptBox["y", 
     RowBox[{"n", "-", "3"}]]}], TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce8574ef-5dbe-e94b-b476-cf2b451f1aa0"],
 "\n\nTo make this happen, say we have:\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Theta]", " ", 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "1"}]], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Theta]"}], ")"}], 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "2"}]], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"\[Theta]", " ", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "1"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Theta]"}], ")"}], 
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]], "               ", 
      RowBox[{"(", "2", ")"}]}]}]}], TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "2"}]], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Gamma]"}], ")"}], 
      RowBox[{"P", "(", 
       SubscriptBox["t", 
        RowBox[{"n", "-", "3"}]], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", 
      SubscriptBox["y", 
       RowBox[{"n", "-", "2"}]]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Gamma]"}], ")"}], 
      SubscriptBox["y", 
       RowBox[{"n", "-", "3"}]], "               ", 
      RowBox[{"(", "3", ")"}]}]}]}], TraditionalForm]}],
  FormatType->TraditionalForm,ExpressionUUID->
  "88258605-fd98-7e48-bbe5-71bcf9dfc649"],
 "\nWe also let:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", 
    RowBox[{"a", "+", 
     SuperscriptBox[
      RowBox[{"b", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "n"]}], ")"}], 
      SubscriptBox["F", "n"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9052b5d2-48fb-784c-8c1e-6348eba5b84f"],
 "\nThis allows once again ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38ce3b1f-e845-ff4b-9e8e-c1bd2388dedc"],
 "\nWe then solve (1)-(3) for the value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", 
     SubscriptBox["t", "n"], ")"}], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"1e83b697-7389-d041-ae84-e6ec525bd006"],
 ", then choose \[Theta] and \[Gamma] such that the formula for ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ad8cdac-e1e6-434e-8837-8ef997b2a80b"],
 " matches ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["BDFL3", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ae10b96-cf70-5b43-8bff-0f981d8de426"],
 " for fixed step size. We then expand it into variable step size using the \
values of \[Theta] and \[Gamma]"
}], "Subsubsection",
 CellChangeTimes->{{3.9894679506381454`*^9, 3.9894683753016415`*^9}, {
  3.9894684409838314`*^9, 3.98946854751437*^9}, {3.9894686219616566`*^9, 
  3.9894688689184837`*^9}, {3.989468900073799*^9, 
  3.9894690086487446`*^9}},ExpressionUUID->"818ba1af-183f-5141-9ab4-\
76b1bdc5279d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Let\[CloseCurlyQuote]s set up the formula for this. For the input code, \
note that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"P", "(", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]], ")"}], "=", "Ptn1"}], ",", " ", 
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"n", "-", "1"}]], "=", "yn1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "400da0c1-3905-8f46-bff9-e81e0301931c"],
 ", and so forth"
}], "Subsubsection",
 CellChangeTimes->{{3.9894690254034233`*^9, 3.989469033821432*^9}, {
  3.9894690958346786`*^9, 
  3.989469147548029*^9}},ExpressionUUID->"42d044e4-c469-df4b-a5b5-\
4238402207e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", " ", "Ptn1"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Theta]"}], ")"}], "Ptn2"}]}], "==", 
     RowBox[{
      RowBox[{"\[Theta]", " ", "yn1"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Theta]"}], ")"}], "yn2"}]}]}], ",", "Ptn1"}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.989469066602619*^9, 3.9894690927293587`*^9}, {
  3.9894691709103737`*^9, 3.989469215806637*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"0c685a55-1dc6-bc4c-bf3d-17cb23192795"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"Ptn1", "\[Rule]", 
    RowBox[{"yn1", "+", 
     RowBox[{"yn2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
     FractionBox[
      RowBox[{"Ptn2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Theta]"}], ")"}]}], "\[Theta]"]}]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.989469206938175*^9, 3.989469216199358*^9}},
 CellLabel->"Out[4]=",ExpressionUUID->"2a11f3a3-b0b0-104e-87f6-a83832d663ef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Note that this means that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"yn2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
   FractionBox[
    RowBox[{"Ptn2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Theta]"}], ")"}]}], "\[Theta]"]}]],
  CellChangeTimes->{{3.989469206938175*^9, 3.989469216199358*^9}},
  ExpressionUUID->"1929fa04-01cb-b840-958a-0b4292e49560"],
 " must equal 0"
}], "Subsubsection",
 CellChangeTimes->{{3.989469251375513*^9, 3.989469263933401*^9}, {
  3.9894693201713448`*^9, 
  3.9894693247422657`*^9}},ExpressionUUID->"d0b5dc91-af42-0e47-8d98-\
c9a6d78ab352"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"yn2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox["1", "\[Theta]"]}], ")"}]}], "+", 
      FractionBox[
       RowBox[{"Ptn2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "\[Theta]"}], ")"}]}], "\[Theta]"]}], "==",
      "0"}], ",", "Ptn2"}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9894692677348976`*^9, 3.989469287795124*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"228b1b5f-58d7-e445-a6ea-456acfc37e62"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"Ptn2", "\[Rule]", "yn2"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9894692882109737`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"8c983eeb-3ecf-064f-8e2a-ad799e839b00"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
This is consistent, meaning we are free to chose any value of \[Theta] except \
0. Let\[CloseCurlyQuote]s also check \[Gamma]\
\>", "Subsubsection",
 CellChangeTimes->{{3.9894692971455593`*^9, 3.9894693393961697`*^9}, {
  3.989469407116295*^9, 
  3.989469416170681*^9}},ExpressionUUID->"aae3a38a-12fb-354a-a20a-\
6cea35d96279"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Gamma]", " ", "Ptn2"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Gamma]"}], ")"}], "Ptn3"}]}], "==", 
     RowBox[{
      RowBox[{"\[Gamma]", " ", "yn2"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Gamma]"}], ")"}], "yn3"}]}]}], ",", "Ptn3"}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.989469425803171*^9, 3.9894695058993416`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"ff947e67-a452-c346-96d3-6a81dc9e8037"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"Ptn3", "\[Rule]", 
    RowBox[{"yn3", "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Ptn2", "-", "yn2"}], ")"}], " ", "\[Gamma]"}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "\[Gamma]"}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9894695064432583`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"36c0f399-d77a-5048-9d30-2dc51151c01e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Ptn2", "-", "yn2"}], ")"}], " ", "\[Gamma]"}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Gamma]"}]], "==", "0"}], ",", "Ptn2"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.989469513366396*^9, 3.9894695315348415`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"e2880004-c2fa-ea45-8996-16fcaaa5769c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"Ptn2", "\[Rule]", "yn2"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9894695280087643`*^9, 3.989469532417143*^9}},
 CellLabel->"Out[8]=",ExpressionUUID->"0f7abc75-5f76-1647-bbef-d0ee91fe713f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We are free then to use any value of \[Gamma] except 1. For now let\
\[CloseCurlyQuote]s try ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0cd0fa4c-d6da-5d44-b739-99a25e69854e"]
}], "Subsubsection",
 CellChangeTimes->{{3.98946954482819*^9, 
  3.989469575444208*^9}},ExpressionUUID->"11288793-eb24-4149-89b2-\
a193df97bac0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]", " ", "Ptn2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Gamma]"}], ")"}], "Ptn3"}]}], "==", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "yn2"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Gamma]"}], ")"}], "yn3"}]}]}], "/.", 
  RowBox[{"\[Gamma]", "->", "0"}]}]], "Input",
 CellChangeTimes->{{3.989473203122282*^9, 3.989473214436327*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"63fa0066-eb97-0a4c-bee3-7641d0506c8d"],

Cell[BoxData[
 RowBox[{"Ptn3", "\[Equal]", "yn3"}]], "Output",
 CellChangeTimes->{3.989473215334137*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"877963f8-97c8-4441-9b4f-646849661974"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Now we define P as a function of t. Here we will go back to the original \
notation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"Ptn1", "->", 
     RowBox[{"P", "(", 
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]], ")"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b629d4b5-e8be-8641-8fab-d17dadc8984d"]
}], "Subsubsection",
 CellChangeTimes->{{3.9894732431683884`*^9, 3.989473253647726*^9}, {
  3.9894742714281673`*^9, 
  3.98947430504364*^9}},ExpressionUUID->"ebd67abc-a9b7-bb40-9ff4-\
aa8b234d18b4"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.9894745898384705`*^9, 3.9894745938147907`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"7bb18b5b-00df-f54c-aac9-9af0298493a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"P", "[", "t1_", "]"}], ":=", 
  RowBox[{"a", "+", 
   RowBox[{"b", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"t1", "-", 
       SubscriptBox["t", "n"]}], ")"}], "2"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"t1", "-", 
      SubscriptBox["t", "n"]}], ")"}], 
    SubscriptBox["F", "n"]}]}]}]], "Input",
 CellChangeTimes->{{3.989473256169277*^9, 3.9894733246920433`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"61300190-2701-8040-bc13-99bccf564df9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eq1", "=", 
  RowBox[{
   RowBox[{"P", "[", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "1"}]], "]"}], "==", 
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"eq2", "=", 
  RowBox[{
   RowBox[{"P", "[", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "2"}]], "]"}], "==", 
   SubscriptBox["y", 
    RowBox[{"n", "-", "2"}]]}]}], "\[IndentingNewLine]", 
 RowBox[{"eq3", "=", 
  RowBox[{
   RowBox[{"P", "[", 
    SubscriptBox["t", 
     RowBox[{"n", "-", "3"}]], "]"}], "==", 
   SubscriptBox["y", 
    RowBox[{"n", "-", "3"}]]}]}]}], "Input",
 CellChangeTimes->{{3.989473331290926*^9, 3.989473422787424*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"3424e7f3-19f1-1d40-91c9-75bc3d064a07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", 
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], "-", 
      SubscriptBox["t", "n"]}], ")"}]}], "+", 
   RowBox[{"b", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["t", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}]], "-", 
       SubscriptBox["t", "n"]}], ")"}], "2"]}]}], "\[Equal]", 
  SubscriptBox["y", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "n"}]]}]], "Output",
 CellChangeTimes->{3.9894733772916393`*^9, 3.989473423660654*^9, 
  3.989474597551922*^9, 3.9894755986563225`*^9},
 CellLabel->"Out[69]=",ExpressionUUID->"a9a3967e-8407-7140-ac63-6fb99fde5e3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", 
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "n"}]], "-", 
      SubscriptBox["t", "n"]}], ")"}]}], "+", 
   RowBox[{"b", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["t", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "n"}]], "-", 
       SubscriptBox["t", "n"]}], ")"}], "2"]}]}], "\[Equal]", 
  SubscriptBox["y", 
   RowBox[{
    RowBox[{"-", "2"}], "+", "n"}]]}]], "Output",
 CellChangeTimes->{3.9894733772916393`*^9, 3.989473423660654*^9, 
  3.989474597551922*^9, 3.9894755986563225`*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"8ff6c75d-9b08-1242-a170-14356a7a1542"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "+", 
   RowBox[{
    SubscriptBox["F", "n"], " ", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "n"}]], "-", 
      SubscriptBox["t", "n"]}], ")"}]}], "+", 
   RowBox[{"b", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["t", 
        RowBox[{
         RowBox[{"-", "3"}], "+", "n"}]], "-", 
       SubscriptBox["t", "n"]}], ")"}], "2"]}]}], "\[Equal]", 
  SubscriptBox["y", 
   RowBox[{
    RowBox[{"-", "3"}], "+", "n"}]]}]], "Output",
 CellChangeTimes->{3.9894733772916393`*^9, 3.989473423660654*^9, 
  3.989474597551922*^9, 3.9894755986563225`*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"1355e9cb-248a-1049-b0bf-87d4d49fe2ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Let\[CloseCurlyQuote]s clean it up a bit by introducing step size: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "n"], "=", 
    RowBox[{
     SubscriptBox["t", 
      RowBox[{"n", "-", "1"}]], "+", 
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79ee09ac-8810-0b47-9a59-e1eb2848f7dd"]
}], "Subsubsection",
 CellChangeTimes->{{3.9894744066294117`*^9, 3.989474437985817*^9}, {
  3.989474470846487*^9, 
  3.989474473957815*^9}},ExpressionUUID->"4bc41530-6d95-334e-97c8-\
6f37895b0e86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eq1", "=", 
  RowBox[{"eq1", "/.", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", 
       RowBox[{"n", "-", "1"}]], "-", 
      SubscriptBox["t", "n"]}], ")"}], "->", 
    RowBox[{"-", 
     SubscriptBox["h", 
      RowBox[{"n", "-", "1"}]]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"eq2", "=", 
  RowBox[{"eq2", "/.", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", 
       RowBox[{"n", "-", "2"}]], "-", 
      SubscriptBox["t", "n"]}], ")"}], "->", 
    RowBox[{
