Cell["\<\
\\left(0<\\omega _n<\\frac{1}{2} \\left(1+\\sqrt{3}\\right)\\land \
\\left(\\frac{1}{8} \\left(\\frac{\\omega _n+1}{-2 \\omega _n^2+2 \\omega \
_n+1}+\\sqrt{3}
   \\sqrt{\\frac{-5 \\omega _n^2+6 \\omega _n+3}{\\left(-2 \\omega _n^2+2 \
\\omega _n+1\\right){}^2}}\\right)\\leq \\omega _{n-1}<\\frac{2 \\left(\\omega
   _n+1\\right)}{-2 \\omega _n^2+2 \\omega _n+1}+\\sqrt{\\frac{12 \\omega \
_n+6}{\\left(-2 \\omega _n^2+2 \\omega _n+1\\right){}^2}}\\lor 0<\\omega
   _{n-1}<\\frac{1}{8} \\left(\\frac{\\omega _n+1}{-2 \\omega _n^2+2 \\omega \
_n+1}+\\sqrt{3} \\sqrt{\\frac{-5 \\omega _n^2+6 \\omega _n+3}{\\left(-2 \\omega
   _n^2+2 \\omega _n+1\\right){}^2}}\\right)\\right)\\right)\\lor \\left(2 \
\\omega _n=1+\\sqrt{3}\\land \\omega _{n-1}>0\\right)\\lor \\left(2 \\omega
   _n>1+\\sqrt{3}\\land 0<\\omega _{n-1}<\\frac{\\omega _n+1}{2 \\omega \
_n^2-2 \\omega _n-1}+\\sqrt{3} \\sqrt{\\frac{\\omega _n^2}{\\left(-2 \\omega \
_n^2+2
   \\omega _n+1\\right){}^2}}\\right)\
\>", "Output",
 CellChangeTimes->{3.9898910041759415`*^9},
 CellLabel->
  "Out[1]//TeXForm=",ExpressionUUID->"17920243-a232-2140-afca-fafabf499f5e"]
}, Open  ]],

