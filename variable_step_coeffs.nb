           RowBox[{"m", "+", "\[CurlyEpsilon]"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}], "==", 
       RowBox[{"m", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Beta]", 
            RowBox[{"n", ",", "j"}]], " ", 
           SuperscriptBox[
            RowBox[{"c", "[", 
             RowBox[{"j", ",", "k"}], "]"}], 
            RowBox[{"m", "-", "1", "+", "\[CurlyEpsilon]"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}]}]}], ")"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "p"}], "}"}]}], "]"}], "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["0", "\[CurlyEpsilon]"], "->", "1"}], ",", 
     RowBox[{"\[CurlyEpsilon]", "->", "0"}], ",", 
     RowBox[{
      SuperscriptBox["0", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[CurlyEpsilon]"}]], "->", "0"}]}], 
    "}"}]}]}]], "Input",
