 CellLabel->
  "In[117]:=",ExpressionUUID->"002d222d-ba72-0944-a630-de86d373cf68"],

Cell["\<\
{((-1 - 2*(omega_n) + 2*(omega_n)^2)*(omega_n1)^2)/(2 + 4*(1 + \
(omega_n))*(omega_n1)), 
 (1 + 2*(1 + (omega_n))*(omega_n1) + (1 + 2*(omega_n) - \
2*(omega_n)^2)*(omega_n1)^2)/(2 + 4*(1 + (omega_n))*(omega_n1)), -3/2, 1}\
\>", "Output",
 CellChangeTimes->{3.9894827521895847`*^9, 3.989482805897434*^9, 
  3.9894832997301044`*^9, 3.989813781755867*^9, 3.989815020184473*^9, 
