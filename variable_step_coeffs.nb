Cell[BoxData[
 RowBox[{
  RowBox[{"alphacoeffs", "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Omega]", "n"], "->", "omega_n"}], ",", 
     RowBox[{
      SubscriptBox["\[Omega]", 
       RowBox[{"n", "-", "1"}]], "->", "omega_n1"}]}], "}"}]}], "//", 
  "InputForm"}]], "Input",
