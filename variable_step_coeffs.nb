Cell["\<\
F_n \\left(\\frac{4 h \\theta }{5}-\\frac{6}{5} h (\\theta \
-1)\\right)+\\left(\\frac{4 (\\theta -1)}{5}-\\frac{\\theta }{5}\\right)
   y_{n-3}+\\left(\\frac{\\theta }{5}-\\frac{9 (\\theta -1)}{5}\\right) \
y_{n-2}+\\theta  y_{n-1}\
\>", "Output",
 CellChangeTimes->{3.9898086719222374`*^9},
 CellLabel->
  "Out[9]//TeXForm=",ExpressionUUID->"290cf23a-73c4-8741-b2d6-32e81a4ef050"]
