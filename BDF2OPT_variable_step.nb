Notebook[{

Cell[CellGroupData[{
Cell["\<\
In this notebook, we will see if the BDF2OPT formula will give us the \
variable step size BDFL3 method\
\>", "Subsection",
 CellChangeTimes->{{3.9887262759224377`*^9, 
  3.9887263065529804`*^9}},ExpressionUUID->"3cccffd2-b1bd-734f-8e63-\
aa734dc83c7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bdf2a", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        FractionBox[
         SubsuperscriptBox["\[Omega]", "n", "2"], 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", 
           SubscriptBox["\[Omega]", "n"]}]}]], ",", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", "n"]}], ")"}], "2"], 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", 
            SubscriptBox["\[Omega]", "n"]}]}]]}], ",", "1"}], "}"}], "/", 
      FractionBox[
       RowBox[{"1", "+", 
        SubscriptBox["\[Omega]", "n"]}], 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         SubscriptBox["\[Omega]", "n"]}]}]]}], ")"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], ",", 
    SubscriptBox["\[Alpha]", "1"], ",", 
    SubscriptBox["\[Alpha]", "2"], ",", 
    SubscriptBox["\[Alpha]", "3"]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdf2b", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bdf3a", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SubsuperscriptBox["\[Omega]", "n", "3"], " ", 
        SubscriptBox["\[Omega]", 
         RowBox[{"1", "+", "n"}]], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Omega]", 
           RowBox[{"1", "+", "n"}]]}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Omega]", "n"]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           SubscriptBox["\[Omega]", "n"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", 
              RowBox[{"1", "+", "n"}]]}], ")"}]}]}], ")"}]}]]}], ",", 
     RowBox[{
      SubscriptBox["\[Omega]", 
       RowBox[{"1", "+", "n"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[Omega]", "n"], "+", 
        FractionBox["1", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Omega]", 
           RowBox[{"1", "+", "n"}]]}]]}], ")"}]}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Omega]", 
           RowBox[{"1", "+", "n"}]]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           SubscriptBox["\[Omega]", "n"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SubscriptBox["\[Omega]", 
              RowBox[{"1", "+", "n"}]]}], ")"}]}]}], ")"}]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Omega]", "n"]}], ")"}], " ", 
        SubscriptBox["\[Omega]", 
         RowBox[{"1", "+", "n"}]]}]]}], ",", 
     FractionBox[
      RowBox[{"1", "+", 
       RowBox[{"2", " ", 
        SubscriptBox["\[Omega]", 
         RowBox[{"1", "+", "n"}]]}], "+", 
       RowBox[{
        SubscriptBox["\[Omega]", "n"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"4", " ", 
           SubscriptBox["\[Omega]", 
            RowBox[{"1", "+", "n"}]]}], "+", 
          RowBox[{"3", " ", 
           SubsuperscriptBox["\[Omega]", 
            RowBox[{"1", "+", "n"}], "2"]}]}], ")"}]}]}], 
      RowBox[{
       SubscriptBox["\[Omega]", 
        RowBox[{"1", "+", "n"}]], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SubscriptBox["\[Omega]", 
          RowBox[{"1", "+", "n"}]]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          SubscriptBox["\[Omega]", "n"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SubscriptBox["\[Omega]", 
             RowBox[{"1", "+", "n"}]]}], ")"}]}]}], ")"}]}]]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bdf3b", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfopta", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", "bdf3a"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]"}], ")"}], "bdf2a"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfoptb", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", "bdf3b"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]"}], ")"}], "bdf2b"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9887265044359283`*^9, 3.9887265153316936`*^9}, {
   3.9887265844121704`*^9, 3.9887266410630665`*^9}, {3.988727294775778*^9, 
