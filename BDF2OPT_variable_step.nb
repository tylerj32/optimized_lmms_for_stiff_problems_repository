 CellLabel->"In[71]:=",ExpressionUUID->"fef7c359-e335-ac4d-b2ed-cea63c5d9bfd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c", "[", "j_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"j", "==", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SubscriptBox["\[Omega]", "n"]], "+", 
        RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{"i", "=", "0"}], 
          RowBox[{"j", "-", "2"}]], 
         RowBox[{"(", 
          RowBox[{
           UnderoverscriptBox["\[Product]", 
            RowBox[{"l", "=", "1"}], "i"], 
           SubscriptBox["\[Omega]", 
            RowBox[{"n", "+", "l"}]]}], ")"}]}]}], ",", 
       RowBox[{"j", ">=", "1"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"6188f300-7168-9441-aa29-7e9b92d0d506"],

