Cell[BoxData[
 RowBox[{
  RowBox[{"c3special", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], "-", "\[Alpha]", "+", 
         FractionBox[
          RowBox[{"5", " ", "\[Beta]"}], "2"]}], ",", 
        RowBox[{"8", "+", 
         RowBox[{"3", " ", "\[Alpha]"}], "-", 
         RowBox[{"6", " ", "\[Beta]"}]}], ",", 
        RowBox[{
         RowBox[{"-", "6"}], "-", 
         RowBox[{"3", " ", "\[Alpha]"}], "+", 
         FractionBox[
          RowBox[{"7", " ", "\[Beta]"}], "2"]}], ",", "\[Alpha]", ",", "1"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "\[Beta]"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", "sum"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{
  3.982132454342203*^9, {3.982132495734997*^9, 3.9821325246595306`*^9}, {
