Cell["\<\
This doesn\[CloseCurlyQuote]t cross into the LHP, therefore this method is \
A-stable\
\>", "Subsubsection",
 CellChangeTimes->{{3.9813477382009544`*^9, 3.9813477757637196`*^9}, 
   3.9821239870565434`*^9, {3.9821252768899193`*^9, 
   3.9821252856551704`*^9}},ExpressionUUID->"e0af0cea-6b6b-844f-8f30-\
e8ff38fb8bca"],

Cell[TextData[{
 "Also note that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox["1", "3"], "-", 
    FractionBox["1", 
     RowBox[{"2", " ", 
      SqrtBox["5"]}]]}], "<", 
   RowBox[{
    FractionBox["5", "6"], "-", 
    FractionBox["1", 
     SqrtBox["2"]]}]}]],
  CellChangeTimes->{
   3.9821230740247154`*^9, 3.982123170794544*^9, {3.982125176490324*^9, 
    3.982125184540169*^9}},ExpressionUUID->
  "27a85a14-a6d3-0046-a049-a9ca2a412c3a"],
 ", the latter of which is the smallest error for 4-step BDF-like methods"
}], "Subsubsection",
 CellChangeTimes->{{3.982126452365162*^9, 3.982126510668707*^9}, {
  3.982126552528324*^9, 
  3.982126555456833*^9}},ExpressionUUID->"7b6163e7-53fe-5449-897d-\
83cd75481b32"],

Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s see the alpha coefficients", "Subsubsection",
 CellChangeTimes->{{3.98212656491016*^9, 
  3.982126579709244*^9}},ExpressionUUID->"2ad626df-bd30-ab44-950f-\
d3f6c935ec70"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]0", ",", "\[Alpha]1", ",", "\[Alpha]2", ",", "\[Alpha]3", ",", 
      "\[Alpha]4", ",", "1"}], "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Alpha]2", "\[Rule]", 
       RowBox[{
        RowBox[{"-", "10"}], "-", 
        RowBox[{"3", " ", "\[Alpha]3"}], "-", 
        RowBox[{"6", " ", "\[Alpha]4"}], "+", 
        FractionBox[
         RowBox[{"9", " ", "\[Beta]5"}], "2"]}]}], ",", 
      RowBox[{"\[Alpha]1", "\[Rule]", 
       RowBox[{"15", "+", 
        RowBox[{"3", " ", "\[Alpha]3"}], "+", 
        RowBox[{"8", " ", "\[Alpha]4"}], "-", 
        RowBox[{"8", " ", "\[Beta]5"}]}]}], ",", 
      RowBox[{"\[Alpha]0", "\[Rule]", 
       RowBox[{
        RowBox[{"-", "6"}], "-", "\[Alpha]3", "-", 
        RowBox[{"3", " ", "\[Alpha]4"}], "+", 
        FractionBox[
         RowBox[{"7", " ", "\[Beta]5"}], "2"]}]}]}], "}"}]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]3", "\[Rule]", 
      FractionBox[
       SqrtBox["5"], "2"]}], ",", 
     RowBox[{"\[Alpha]4", "\[Rule]", 
      RowBox[{
       FractionBox["1", "44"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "45"}], "-", 
         RowBox[{"14", " ", 
          SqrtBox["5"]}]}], ")"}]}]}], ",", 
     RowBox[{"\[Beta]5", "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["5", "44"]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "7"}], "+", 
         SqrtBox["5"]}], ")"}]}]}]}], "}"}]}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9821265989810276`*^9, 3.982126623974901*^9}, {
  3.9821333407086315`*^9, 3.9821333440759583`*^9}},
