Cell[CellGroupData[{
Cell[TextData[{
 "We will now attempt to find if 4-step ",
 Cell[BoxData[
  FormBox[
   RowBox[{"L", "(", "\[Kappa]", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1257d533-9fb3-be4b-9b1f-b84567f24165"],
 " LMMs exist"
}], "Subsection",
 CellChangeTimes->{{3.9810105543425827`*^9, 3.981010574368044*^9}, {
  3.981689467173994*^9, 
  3.981689485316839*^9}},ExpressionUUID->"bb55eb9a-2a34-b744-8f93-\
70391a6ac1d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "a_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b2b78ae2-f5ba-624f-b1a2-8006447feae8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Below I have combined all of the steps required to get the real part of ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Rho]", "\[Sigma]"], TraditionalForm]],ExpressionUUID->
  "9bf6e3e1-8229-b246-a08c-56606fd5dc66"],
 ":"
}], "Subsection",
 CellChangeTimes->{{3.9813429248935623`*^9, 
  3.9813430090686626`*^9}},ExpressionUUID->"f7aa3faf-1428-3445-ae92-\
9ca63be02d91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BDFLikeConditions", "[", "k_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "orderConditions", ",", "BDFLikeOrderConditions", ",", 
      "reducedBDFLikeOrderConditions", ",", "rhooversigma", ",", 
      "realPartInPolar", ",", "cond", ",", "result"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"orderConditions", "=", 
      RowBox[{
       RowBox[{"And", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              SubscriptBox["\[Alpha]", "i"], " ", 
              SuperscriptBox["i", 
               RowBox[{"q", "+", "\[Epsilon]"}]]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", "k"}], "}"}]}], "]"}], "==", 
           RowBox[{"q", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               SubscriptBox["\[Beta]", "i"], " ", 
               SuperscriptBox[
                RowBox[{"(", "i", ")"}], 
                RowBox[{"q", "+", "\[Epsilon]", "-", "1"}]]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "0", ",", "k"}], "}"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"q", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "/.", 
       RowBox[{"{", " ", 
        RowBox[{
         RowBox[{
          SuperscriptBox["0", "\[Epsilon]"], "->", "1"}], ",", " ", 
         RowBox[{
          SuperscriptBox["0", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Epsilon]"}]], "->", "0"}], ",", 
         RowBox[{"\[Epsilon]", "->", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"cond", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Alpha]", "k"], "->", "1"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Beta]", "i"], "->", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"BDFLikeOrderConditions", "=", 
      RowBox[{"orderConditions", "/.", "cond"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"reducedBDFLikeOrderConditions", "=", 
      RowBox[{
       RowBox[{"Reduce", "[", "BDFLikeOrderConditions", "]"}], "//", 
       "ToRules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rhooversigma", "[", "\[Zeta]_", "]"}], ":=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"Flatten", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                SubscriptBox["\[Alpha]", "i"], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "0", ",", 
                  RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], 
             "}"}]}], "]"}], "[", "\[Zeta]", "]"}], 
         RowBox[{
          RowBox[{"\[Sigma]", "[", 
           RowBox[{"Flatten", "@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "0", ",", 
                  RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ",", 
              SubscriptBox["\[Beta]", "k"]}], "}"}]}], "]"}], "[", "\[Zeta]", 
          "]"}]], "/.", "reducedBDFLikeOrderConditions"}], "//", 
       "Simplify"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"realPartInPolar", "=", 
      RowBox[{
       RowBox[{"ComplexExpand", "@", 
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rhooversigma", "[", 
            RowBox[{"r", " ", 
             RowBox[{"Exp", "[", 
              RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}], "]"}]}], "]"}], "//",
            "ExpToTrig"}], "//", "TrigExpand"}], "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "->", "c"}], ",", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], "->", 
          RowBox[{"1", "-", 
           SuperscriptBox["c", "2"]}]}], ",", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "4"], "->", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["c", "2"]}], ")"}], "2"]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"realPartInPolar", "//", "Simplify"}]}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.981010706050329*^9, 3.981010716745186*^9}, {
   3.9810858120687256`*^9, 3.981085851424143*^9}, {3.9810982472028503`*^9, 
   3.981098251498518*^9}, {3.981098766919264*^9, 3.9810987730001965`*^9}, {
   3.9813430263215904`*^9, 3.981343029349039*^9}, {3.981346859702259*^9, 
