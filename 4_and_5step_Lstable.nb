Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"\[Alpha]3", "\[Equal]", 
     RowBox[{
      FractionBox["1", "5"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "-", 
        SqrtBox["21"]}], ")"}]}]}], "&&", 
    RowBox[{"\[Beta]4", "\[Equal]", 
     RowBox[{
      RowBox[{
       FractionBox["1", "21"], " ", 
       RowBox[{"(", 
        RowBox[{"29", "+", 
         RowBox[{"2", " ", 
          RowBox[{"(", 
