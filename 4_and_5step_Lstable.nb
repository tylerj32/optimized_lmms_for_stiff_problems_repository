Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"\[Sigma]", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
          SubscriptBox["\[Beta]", "5"]}], "}"}], "]"}], "[", "1", "]"}]], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox["j", "3"], 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             SubscriptBox["\[Alpha]", "0"], ",", 
             SubscriptBox["\[Alpha]", "1"], ",", 
             SubscriptBox["\[Alpha]", "2"], ",", 
