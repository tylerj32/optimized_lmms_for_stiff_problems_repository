     SuperscriptBox["c", "4"], " ", "r"}], "+", 
    RowBox[{"8", " ", 
     SuperscriptBox["c", "2"], " ", "r", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "40"}], "+", 
       RowBox[{"12", " ", 
        SqrtBox["5"]}], "+", 
       RowBox[{"11", " ", 
        SqrtBox["5"], " ", 
        SuperscriptBox["r", "2"]}]}], ")"}]}], "-", 
    RowBox[{"4", " ", 
     SuperscriptBox["c", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "65"}], "+", 
       RowBox[{"25", " ", 
        SqrtBox["5"]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"25", "+", 
          RowBox[{"9", " ", 
           SqrtBox["5"]}]}], ")"}], " ", 
        SuperscriptBox["r", "2"]}]}], ")"}]}], "+", 
    RowBox[{"4", " ", "r", " ", 
     RowBox[{"(", 
      RowBox[{"10", "-", 
       RowBox[{"3", " ", 
        SqrtBox["5"]}], "-", 
       RowBox[{"11", " ", 
        SqrtBox["5"], " ", 
        SuperscriptBox["r", "2"]}], "+", 
       RowBox[{"22", " ", 
        SuperscriptBox["r", "4"]}]}], ")"}]}], "+", 
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "65"}], "+", 
       RowBox[{"25", " ", 
        SqrtBox["5"]}], "+", 
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{"25", "+", 
          RowBox[{"9", " ", 
           SqrtBox["5"]}]}], ")"}], " ", 
        SuperscriptBox["r", "2"]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"45", "+", 
          RowBox[{"14", " ", 
           SqrtBox["5"]}]}], ")"}], " ", 
        SuperscriptBox["r", "4"]}]}], ")"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9821252441850853`*^9, 3.9821252564518375`*^9}, 
   3.98213437515654*^9},
