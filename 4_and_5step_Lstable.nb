 CellLabel->"In[5]:=",ExpressionUUID->"4cc4e3ba-8819-9049-8e77-9f181c292bd9"]
}, Open  ]],

Cell[TextData[{
 "This will now give us the real part of the ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Rho]", "\[Sigma]"], TraditionalForm]],ExpressionUUID->
  "b58eae34-2cd8-5f41-9c06-49f6f815a63a"],
 " equation by simply specifying the number of steps. Note that we simplify \
things by replacing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Sin", "(", "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "548456f7-ca2c-ab42-8e9b-7d79c7f1dbb7"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Cos", "(", "\[Theta]", ")"}], TraditionalForm]],ExpressionUUID->
  "1b92972b-25a2-524d-af2b-f75051172dcf"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{"1", "-", 
      SuperscriptBox["c", "2"]}]], "and", " ", "c"}], TraditionalForm]],
  ExpressionUUID->"5f53f3e9-874f-8e4e-a974-9b53ac8ecae1"],
 ", respectively, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "<=", "c", "<=", "1"}], TraditionalForm]],
  ExpressionUUID->"9c962d10-3de5-644c-842b-00dc36dbaed7"],
 "."
}], "Subsection",
