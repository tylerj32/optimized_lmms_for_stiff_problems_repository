Cell[CellGroupData[{

Cell["\<\
We will repeat this procedure for BDF2OPT(5), but we will assume that we only \
need to check the results at the end\
\>", "Subsection",
 CellChangeTimes->{{3.9849720721199913`*^9, 
  3.9849721132421*^9}},ExpressionUUID->"36bbbab0-d76b-bf44-8b71-2ac1d8942139"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bdf4a", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"3", ",", 
      RowBox[{"-", "16"}], ",", "36", ",", 
      RowBox[{"-", "48"}], ",", "25"}], "}"}], "/", "12"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bdf4b", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "12"}], "}"}], "/", 
    "12"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfopt5a", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "bdf4a"}], "+", 
    RowBox[{"\[Beta]", " ", "bdf3a"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]", "-", "\[Gamma]"}], ")"}], "bdf2a"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfopt5b", "[", 
    RowBox[{"\[Gamma]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "bdf4b"}], "+", 
    RowBox[{"\[Beta]", " ", "bdf3b"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]", "-", "\[Gamma]"}], ")"}], "bdf2b"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9845389566334705`*^9, 3.9845390598822575`*^9}, {
  3.9845391051362553`*^9, 3.9845391599894943`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"a413fcf0-539a-5a4f-afdd-7ac35244db30"],

