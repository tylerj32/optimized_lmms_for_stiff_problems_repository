       RowBox[{"12", " ", 
        SuperscriptBox["\[Beta]", "2"]}]]}], ">=", "0"}], "&&", 
    RowBox[{"\[Beta]", ">", "0"}]}], ",", "\[Beta]", ",", "Reals"}], 
