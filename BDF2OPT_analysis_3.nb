Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "41"], " ", 
    RowBox[{"(", 
     RowBox[{"13", "-", 
      RowBox[{"8", " ", 
       SqrtBox["2"]}]}], ")"}]}], ",", 
   RowBox[{"-", 
