Cell[BoxData[
 RowBox[{
  RowBox[{"bdfoptC", "[", 
   RowBox[{"\[Gamma]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"bdfopt5a", "[", 
       RowBox[{"\[Gamma]", ",", "\[Beta]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"bdfopt5b", "[", 
       RowBox[{"\[Gamma]", ",", "\[Beta]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "//", "Simplify"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.985179190606159*^9, 3.9851792130005474`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"f5e90583-b97e-c641-b91b-20e1571d2159"],

