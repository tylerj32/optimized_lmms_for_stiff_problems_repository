Cell[CellGroupData[{

Cell["\<\
The first root matches, but let\[CloseCurlyQuote]s make sure the second root \
does too\
\>", "Subsubsection",
 CellChangeTimes->{{3.984971749335104*^9, 
  3.9849717715454693`*^9}},ExpressionUUID->"ff70fdd6-6fb3-124e-8fe2-\
86ebe9d54564"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"ArcTan", "[", 
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"2", " ", "\[Beta]"}]}], 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[Beta]"}]}]]], "]"}]}], "==", 
    RowBox[{"2", 
     RowBox[{"ArcCos", "[", 
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"2", "\[Beta]"}], "+", "1"}]], 
       RowBox[{"2", 
        SqrtBox["\[Beta]"]}]], "]"}]}]}], ",", "\[Beta]", ",", "Reals"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9849701160667496`*^9, 3.984970129615507*^9}, {
  3.984970434958004*^9, 3.9849705998716946`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"222f64f6-8e2a-124c-826f-507401e54260"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Beta]", "\[Equal]", 
   FractionBox["1", "2"]}], "||", 
  RowBox[{"\[Beta]", ">", 
   FractionBox["1", "2"]}]}]], "Output",
 CellChangeTimes->{{3.9849701242940807`*^9, 3.9849701304342957`*^9}, {
   3.9849704368981667`*^9, 3.9849704526203136`*^9}, {3.984970504254259*^9, 
