Cell[CellGroupData[{

Cell[TextData[{
 "We successfully reproduced the results, so we now use Reduce to find the \
range for \[Beta], and include the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b227ba86-bb3d-104d-a2c1-5aaa0d29aec2"],
 " as given in the paper"
}], "Subsubsection",
