Notebook[{

Cell[CellGroupData[{
Cell["\<\
Since we found that BDF2OPT corresponded to the BDF-like LMMs, in this \
notebook we will reproduce the same methods they employed to try and reach a \
6-step BDF-like LMM\
\>", "Subsection",
 CellChangeTimes->{{3.9849664677116146`*^9, 
  3.9849665507591553`*^9}},ExpressionUUID->"f40eb12e-1a2f-4d4a-bc35-\
98ad8add5cc0"],

Cell[CellGroupData[{

Cell["First, we work with BDF2OPT(4)", "Subsubsection",
 CellChangeTimes->{{3.9849665750919514`*^9, 
  3.984966592181877*^9}},ExpressionUUID->"65eadc7c-a183-f342-b1d6-\
ea37e5b34b59"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "a_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"81d6322f-7334-6e4c-805a-4aeff26e8997"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bdf2a", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", 
       RowBox[{"-", "4"}], ",", "3"}], "}"}], "/", "2"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], ",", 
    SubscriptBox["\[Alpha]", "1"], ",", 
    SubscriptBox["\[Alpha]", "2"], ",", 
    SubscriptBox["\[Alpha]", "3"]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdf2b", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "2"}], "}"}], "/", 
     "2"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bdf3a", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "2"}], ",", "9", ",", 
      RowBox[{"-", "18"}], ",", "11"}], "}"}], "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bdf3b", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "6"}], "}"}], "/", 
    "6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfopta", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", "bdf3a"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]"}], ")"}], "bdf2a"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bdfoptb", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", "bdf3b"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Beta]"}], ")"}], "bdf2b"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9845372129489822`*^9, 3.9845372202250633`*^9}, {
  3.9845372819462795`*^9, 3.9845373085845966`*^9}, {3.984538277442335*^9, 
  3.9845382858072376`*^9}, {3.98453906641971*^9, 3.9845390737154045`*^9}, {
  3.984554908437252*^9, 3.984554952611185*^9}, {3.9851643037162895`*^9, 
  3.985164340836006*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"0c2abfc6-28d5-a445-916b-aed84f4129d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bdfoptC", "[", "\[Beta]_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"bdfopta", "[", "\[Beta]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"bdfoptb", "[", "\[Beta]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "//", "Simplify"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9845438568823605`*^9, 3.9845439245287304`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"617e67fc-f2aa-3043-9140-8f68f45ad4ff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Minimize", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"bdfoptC", "[", "\[Beta]", "]"}], ",", 
     RowBox[{
      FractionBox["1", "2"], ">=", "\[Beta]", ">", "0"}]}], "}"}], ",", 
   "\[Beta]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9887257938554344`*^9, 3.9887258336044426`*^9}, {
  3.988725889402546*^9, 3.988725922135664*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"dc3d1914-3af7-f844-86c0-44c77f8873ba"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "6"], ",", 
   RowBox[{"{", 
    RowBox[{"\[Beta]", "\[Rule]", 
     FractionBox["1", "2"]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9887258395539227`*^9, {3.9887258936698284`*^9, 3.988725922887789*^9}},
 CellLabel->"Out[13]=",ExpressionUUID->"02b32733-420f-e941-af85-f03f35f20131"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bdfopta", "[", 
   RowBox[{"1", "/", "2"}], "]"}], "*", 
  RowBox[{"3", "/", "5", " ", 
   RowBox[{"(*", 
    RowBox[{"\[Alpha]", " ", "coefficients"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9849666400767136`*^9, 3.9849666827926617`*^9}, {
  3.9849667150365257`*^9, 3.984966722407915*^9}, {3.9851642950206947`*^9, 
  3.98516429574218*^9}, {3.9851653060192375`*^9, 3.9851653087613544`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"4e3866cf-181a-db4a-8aa2-e394b75424ab"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   RowBox[{"-", 
    FractionBox["1", "10"]}], ",", 
   FractionBox["3", "5"], ",", 
   RowBox[{"-", 
    FractionBox["3", "2"]}], ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{{3.984966659906126*^9, 3.9849666834854527`*^9}, 
   3.985154899831415*^9, {3.985164296672985*^9, 3.985164349113573*^9}, 
   3.9851653096237144`*^9, 3.9851790333317833`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"873fa40b-0436-2748-b275-92f7ffa0d3c1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bdfoptb", "[", 
   RowBox[{"1", "/", "2"}], "]"}], "*", 
  RowBox[{"3", "/", "5", " ", 
   RowBox[{"(*", 
    RowBox[{"\[Beta]", " ", "coefficients"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.984966687965851*^9, 3.9849667306508102`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"9264acb7-e105-a749-8e7f-6a0176d6928e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
   FractionBox["3", "5"]}], "}"}]], "Output",
 CellChangeTimes->{
  3.984966704067913*^9, 3.9851549011446686`*^9, {3.985164325337427*^9, 
   3.985164352054039*^9}, 3.9851790359265156`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"44485a2d-0f25-e84a-911d-97717efb72b9"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "These two parts above tell us that when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    FractionBox["1", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7cd123bf-65ce-654e-9716-05ca1eb5cc10"],
 ", we get BDFL3"
}], "Subsubsection",
 CellChangeTimes->{{3.987063094823908*^9, 
  3.9870631212487392`*^9}},ExpressionUUID->"286077ff-b466-de46-abbb-\
7019232208db"],

Cell[CellGroupData[{

Cell["\<\
Now, according to Carpenter, the way they discovered the minimum error was by \
taking their specialized equation of the RLC, taking the real part, and then \
analytically solving for A-stability. \
\>", "Subsubsection",
 CellChangeTimes->{{3.9849667792639847`*^9, 
  3.9849668592309628`*^9}},ExpressionUUID->"4c27c675-298c-134f-824d-\
bce9a214bbc7"],

Cell[BoxData[
 RowBox[{"Clear", "[", "rlc", "]"}]], "Input",
 CellChangeTimes->{{3.984969318270767*^9, 3.984969321353693*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"fcfbbece-d8d4-ff45-9163-81e53ac38572"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rlc", "[", 
   RowBox[{"k_", ",", "\[Theta]_"}], "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"j", "=", "1"}], "k"], 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "j"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}], ")"}], "j"]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.984966891580639*^9, 3.9849669122562695`*^9}, {
  3.9849683933729267`*^9, 3.984968416049631*^9}, {3.9849693029404564`*^9, 
  3.984969334357025*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"4b89bc93-c76d-e541-88db-4a71913867e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rlc2", "[", "\[Beta]_", "]"}], ":=", 
  RowBox[{
   RowBox[{"\[Beta]", " ", 
    RowBox[{"rlc", "[", 
     RowBox[{"3", ",", "\[Theta]"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Beta]"}], ")"}], 
    RowBox[{"rlc", "[", 
     RowBox[{"2", ",", "\[Theta]"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.984966922857191*^9, 3.9849669668643703`*^9}, {
  3.984968369671871*^9, 3.984968385871416*^9}, {3.9849684216215916`*^9, 
  3.9849684581584663`*^9}, {3.984968912676241*^9, 3.984968913965391*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"156793bc-b7e4-4d4f-b1eb-c7c37f47b692"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rlc2", "[", "\[Beta]", "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9849684613770676`*^9, 3.984968469974119*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"7a02fbd6-4e54-9244-9c1d-cf63e3867c88"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "6"], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "3"}], " ", "\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", "\[Beta]"}], "+", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
     RowBox[{"(", 
      RowBox[{"9", "+", 
       RowBox[{"2", " ", "\[Beta]"}]}], ")"}]}], "-", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
     RowBox[{"(", 
      RowBox[{"3", "+", 
       RowBox[{"4", " ", "\[Beta]"}]}], ")"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9849684653451595`*^9, 3.984968470476513*^9}, 
   3.9849689234187584`*^9, 3.984969344556284*^9, 3.985154978176239*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"817df1f2-a5df-1e42-bd6b-f2860f53d524"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Let\[CloseCurlyQuote]s make sure that my result is equivalent to \
theirs", "Subsubsection",
 CellChangeTimes->{{3.9849716374649715`*^9, 
  3.984971652646721*^9}},ExpressionUUID->"5555bf7e-333a-c842-90b3-\
e3573621b62d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"rlc2", "[", "\[Beta]", "]"}], "]"}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[Minus]", "4"}], "3"], 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        FractionBox["\[Theta]", "2"], "]"}], "4"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "\[Beta]", " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{"2", "\[Beta]"}], "\[Minus]", "3"}], ")"}]}], "+", 
     RowBox[{"I", " ", 
      FractionBox["1", "3"], 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "\[Beta]", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "\[Theta]"}], "]"}]}], "\[Minus]", 
        RowBox[{"3", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "\[Beta]"}], "+", "1"}], ")"}], " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{"4", "\[Beta]"}], "+", "6"}], ")"}]}]}], ")"}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.984969147054291*^9, 3.984969257930132*^9}, {
  3.984969374554508*^9, 3.984969392860691*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"8894c204-1524-a142-b058-06cd5c7b67b0"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{
  3.9849692584835415`*^9, 3.984969346583475*^9, {3.984969382270855*^9, 
   3.984969393910763*^9}, 3.985154984532503*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"8339636c-c3eb-6744-8afb-ce229260fb20"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
We continue the same procedure as Carpenter, namely finding the extrema by \
taking the derivative and finding the roots\
\>", "Subsubsection",
 CellChangeTimes->{{3.984971677993206*^9, 
  3.984971722794533*^9}},ExpressionUUID->"8e4d8a65-b141-f940-9b22-\
0c15ea7bfad4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Re", "[", 
      RowBox[{"rlc2", "[", "\[Beta]", "]"}], "]"}], "]"}], ",", "\[Theta]"}], 
   "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9849685456352043`*^9, 3.9849685612453957`*^9}, {
  3.984969090059244*^9, 3.9849691088384686`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"4072f11c-ef02-0e4a-b42b-70c4eb4cc388"],

Cell[BoxData[
 RowBox[{"4", " ", 
  SuperscriptBox[
   RowBox[{"Sin", "[", 
    FractionBox["\[Theta]", "2"], "]"}], "2"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Theta]", "]"}], "-", 
    RowBox[{"\[Beta]", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9849685573507175`*^9, 3.984968561786621*^9}, 
   3.9849689264130325`*^9, 3.9849691106261616`*^9, 3.984969422461956*^9, 
   3.985154987048006*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"b7f53c5d-5d8c-3341-9b7a-b972cfe07faa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"4", " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         FractionBox["\[Theta]", "2"], "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "-", 
         RowBox[{"\[Beta]", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "\[Theta]"}], "]"}]}]}], ")"}]}], "==", "0"}], "&&", 
     RowBox[{"0", "<=", "\[Theta]", "<=", 
      RowBox[{"2", "\[Pi]"}]}]}], ",", "\[Theta]", ",", "Reals"}], "]"}], "//",
   "Simplify"}]], "Input",
 CellChangeTimes->{{3.984968609849468*^9, 3.984968620781212*^9}, 
   3.984969053588928*^9, 3.984969120496969*^9, {3.9849698127688026`*^9, 
   3.984969861956871*^9}, {3.9849699349227448`*^9, 3.984969953071228*^9}, {
   3.9849700270681973`*^9, 3.984970044642067*^9}, {3.9849703749465046`*^9, 
   3.984970398393633*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"997897bb-025a-b14b-a74d-0f056ddef5b5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Theta]", "\[Equal]", "0"}], "||", 
  RowBox[{"\[Theta]", "\[Equal]", "\[Pi]"}], "||", 
  RowBox[{"\[Theta]", "\[Equal]", 
   RowBox[{"2", " ", "\[Pi]"}]}], "||", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Beta]", "<", 
       RowBox[{"-", 
        FractionBox["1", "2"]}]}], "||", 
      RowBox[{
       RowBox[{"2", " ", "\[Beta]"}], ">", "1"}]}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "+", 
        RowBox[{"2", " ", 
         RowBox[{"ArcTan", "[", 
          SqrtBox[
           FractionBox[
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             RowBox[{"2", " ", "\[Beta]"}]}], 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "\[Beta]"}]}]]], "]"}]}]}], "\[Equal]", 
       RowBox[{"2", " ", "\[Pi]"}]}], "||", 
      RowBox[{"\[Theta]", "\[Equal]", 
       RowBox[{"2", " ", 
        RowBox[{"ArcTan", "[", 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"2", " ", "\[Beta]"}]}], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Beta]"}]}]]], "]"}]}]}]}], ")"}]}], 
   ")"}]}]], "Output",
