      RowBox[{"1", "-", 
       FractionBox["1", 
        SqrtBox["2"]]}], ",", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "5"}], "2"], "+", 
       RowBox[{"2", 
        SqrtBox["2"]}]}]}], "]"}], ")"}], "/", 
   RowBox[{"(", 
