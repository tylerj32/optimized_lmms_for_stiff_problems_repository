Notebook[{
Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.983952758411482*^9, 3.9839527642177353`*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"a67f9389-8626-e94e-bfd2-95539c7ed03a"],

Cell[CellGroupData[{

Cell["\<\
This notebook will merely contain a list of the Pareto-optimal methods. In \
other words, we provide the set of methods where the LMM will have the \
smallest possible error for a given value of \[Kappa]\
\>", "Subsection",
 CellChangeTimes->{{3.9839516575621605`*^9, 3.9839517511871567`*^9}, {
  3.983951990349983*^9, 
  3.983952049030142*^9}},ExpressionUUID->"263b2b5f-5c03-b444-96cc-\
49cc5f9d2753"],

Cell[CellGroupData[{

Cell[TextData[{
 "2-step LMMs:\nNote that for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f34689c6-cab0-344e-bac3-098b59d26fef"],
 " the LMM is the BDF2 method, and for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2579b917-535d-5d43-8d3d-b64bd3e6d2d2"],
 " we have the Trapezoidal method. This means for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54aff3c4-3a4a-bc44-ad70-1f510b4600de"],
 " we will have LMMs with an error between ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "3"]}], " ", "and"}], " ", "-", 
    FractionBox["1", "12"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b544fb1-74b3-4c4b-a8b0-8c71f39a2006"],
 "\nDue to the coefficient conditions for consistency, we can narrow down the \
coefficients of the LMM to the following parameters:\n\[Alpha]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"3", "-", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "1"]}], "-", 
      RowBox[{"4", " ", 
       SubscriptBox["\[Beta]", "2"]}]}], ",", 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      RowBox[{"2", " ", 
       SubscriptBox["\[Beta]", "1"]}], "+", 
      RowBox[{"4", " ", 
       SubscriptBox["\[Beta]", "2"]}]}], ",", "1"}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "97c15c92-8305-2843-834e-2045c61cea6f"],
 "\n\[Beta]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      SubscriptBox["\[Beta]", "1"], "+", 
      RowBox[{"3", " ", 
       SubscriptBox["\[Beta]", "2"]}]}], ",", 
     SubscriptBox["\[Beta]", "1"], ",", 
     SubscriptBox["\[Beta]", "2"]}], "}"}], TraditionalForm]],ExpressionUUID->
  "9b55eb70-c4e6-fe42-a622-3f6753c91f12"],
 "\nThis means that we only have two free parameters, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Beta]", "1"], "and", " ", 
    SubscriptBox["\[Beta]", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f12ca5d0-3b0b-3740-b992-c415b4cd4092"]
}], "Subsubsection",
 CellChangeTimes->{{3.9839521306506367`*^9, 3.9839523675259495`*^9}, {
  3.983952496309431*^9, 
  3.9839525942290535`*^9}},ExpressionUUID->"621cf77f-3ae6-7a44-8efc-\
41d3176b896d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond2step", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Beta]0", "-", "\[Beta]1", "+", "\[Beta]2"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", "\[Beta]0", "+", "\[Beta]1", "+", 
            "\[Beta]2"}], ")"}]}], "\[LessEqual]", "0"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "+", "\[Beta]0", "-", "\[Beta]1", "-", 
            RowBox[{"3", " ", "\[Beta]2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"\[Beta]0", "+", "\[Beta]1", "+", "\[Beta]2"}], ")"}]}], "\[LessEqual]",
          "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"4", " ", "\[Beta]0", " ", "\[Beta]2"}], ">", 
             SuperscriptBox["\[Beta]1", "2"]}], "&&", 
            RowBox[{"\[Beta]0", "\[NotEqual]", "\[Beta]2"}]}], ")"}], "||", 
          RowBox[{
           RowBox[{
            SuperscriptBox["\[Beta]0", "2"], "+", 
            SuperscriptBox["\[Beta]1", "2"], "+", 
            SuperscriptBox["\[Beta]2", "2"]}], "\[GreaterEqual]", 
           RowBox[{"6", " ", "\[Beta]0", " ", "\[Beta]2"}]}]}], ")"}]}], 
       ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]2", " ", 
           SuperscriptBox["\[Kappa]", "2"]}], "]"}], ">", 
         RowBox[{"Abs", "[", "\[Beta]0", "]"}]}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           SuperscriptBox["\[Beta]0", "2"], "-", 
           RowBox[{
            SuperscriptBox["\[Beta]2", "2"], " ", 
            SuperscriptBox["\[Kappa]", "4"]}]}], "]"}], ">", 
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]1", " ", "\[Kappa]", " ", 
           RowBox[{"(", 
            RowBox[{"\[Beta]0", "-", 
             RowBox[{"\[Beta]2", " ", 
              SuperscriptBox["\[Kappa]", "2"]}]}], ")"}]}], "]"}]}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[Beta]0", "->", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
        RowBox[{"3", " ", "\[Beta]2"}]}]}], "}"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.982741302912447*^9, 3.9827413044304314`*^9}, {
   3.982744891309969*^9, 3.98274490044223*^9}, {3.9827449645057907`*^9, 
   3.982744979386194*^9}, 3.982823899648157*^9, {3.982824926001028*^9, 
   3.9828249360769444`*^9}, {3.9839496036606903`*^9, 3.983949604321991*^9}, {
   3.9839496921847916`*^9, 3.983949693604517*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"5bd9150a-660d-8042-9bc3-93b6541568aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32step", "[", 
   RowBox[{"\[Beta]1_", ",", "\[Beta]2_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"Abs", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
      RowBox[{"8", " ", "\[Beta]2"}]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
      RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98282360214221*^9, 3.9828236189858093`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"8d495daa-1887-2d46-a122-2370998a873c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Kappa]list2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Minimize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c32step", "[", 
             RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "]"}], ",", 
            RowBox[{"cond2step", "/.", " ", 
             RowBox[{"\[Kappa]", "->", "k"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "}"}]}], "]"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "1", ",", 
       RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9827449940026627`*^9, {3.982745105996086*^9, 3.9827451579631405`*^9}, 
   3.9828233517283688`*^9, {3.982823632518505*^9, 3.982823659803295*^9}, 
