Cell[CellGroupData[{

Cell["Special 3-step LMMs (2 nonzero \[Beta] - coefficients)", "Subsection",
 CellChangeTimes->{{3.9839530839645977`*^9, 
  3.983953111746235*^9}},ExpressionUUID->"cd88ff57-6a2e-a34f-89b0-\
aa6280ec936f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Again, thanks to the consistency conditions, the coefficients are reduced \
as the following:\n\[Alpha]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox["\[Beta]2", "2"], "+", 
      FractionBox[
       RowBox[{"3", " ", "\[Beta]3"}], "2"]}], ",", 
     RowBox[{"3", "-", 
      RowBox[{"2", " ", "\[Beta]2"}], "-", 
      RowBox[{"4", " ", "\[Beta]3"}]}], ",", 
     RowBox[{
      RowBox[{"-", "3"}], "+", 
      FractionBox[
       RowBox[{"3", " ", "\[Beta]2"}], "2"], "+", 
      FractionBox[
       RowBox[{"5", " ", "\[Beta]3"}], "2"]}], ",", "1"}], "}"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "743f94e0-e558-fe49-af47-3d57218e847f"],
 "\n\[Beta]: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "\[Beta]2", ",", "\[Beta]3"}], "}"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2f56916-27eb-1842-9012-b3b38cceff60"]
}], "Subsubsection",
 CellChangeTimes->{{3.9839540457660313`*^9, 
  3.983954203605524*^9}},ExpressionUUID->"aa63a7d7-2505-f14a-bd58-\
d8922ddc7cb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"8bbbcb95-38fc-6847-a9f1-a0c655b81aba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32beta", "[", 
   RowBox[{"\[Beta]2_", ",", "\[Beta]3_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox["\[Beta]2", "2"], "+", 
         FractionBox[
