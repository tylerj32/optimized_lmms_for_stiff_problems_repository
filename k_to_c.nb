Notebook[{
Cell[BoxData[
 RowBox[{"ClearAll", "[", "\"\<`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.982741380994791*^9, 3.9827413858391685`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"1951d0d5-cd9a-3941-9ae6-45c9a305360f"],

Cell[CellGroupData[{

Cell["\<\
This notebook will ONLY comprise a comparison of \[Kappa] to the minimum \
error of various types of LMMs\
\>", "Subsection",
 CellChangeTimes->{{3.9827411373158073`*^9, 
  3.982741202884453*^9}},ExpressionUUID->"bb75e351-6516-f741-ac01-\
cce8164d880e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]", "[", "a_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "[", "b_", "]"}], "[", "xi_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"[", 
       RowBox[{"i", "+", "1"}], "]"}], "]"}], 
     SuperscriptBox["xi", "i"]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"Length", "[", "b", "]"}], "-", "1"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"be62accd-3bed-5941-899b-298e7640f1ee"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scenario 1: 2-step LMMs (all \[Beta] coefficients are nonzero)", \
"Subsection",
 CellChangeTimes->{{3.9827412706254215`*^9, 
  3.9827412984105473`*^9}},ExpressionUUID->"b9836fe3-ae40-4e43-b416-\
d59b7075cca5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond2step", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Beta]0", "-", "\[Beta]1", "+", "\[Beta]2"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", "\[Beta]0", "+", "\[Beta]1", "+", 
            "\[Beta]2"}], ")"}]}], "\[LessEqual]", "0"}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "+", "\[Beta]0", "-", "\[Beta]1", "-", 
            RowBox[{"3", " ", "\[Beta]2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"\[Beta]0", "+", "\[Beta]1", "+", "\[Beta]2"}], ")"}]}], "\[LessEqual]",
          "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"4", " ", "\[Beta]0", " ", "\[Beta]2"}], ">", 
             SuperscriptBox["\[Beta]1", "2"]}], "&&", 
            RowBox[{"\[Beta]0", "\[NotEqual]", "\[Beta]2"}]}], ")"}], "||", 
          RowBox[{
           RowBox[{
            SuperscriptBox["\[Beta]0", "2"], "+", 
            SuperscriptBox["\[Beta]1", "2"], "+", 
            SuperscriptBox["\[Beta]2", "2"]}], "\[GreaterEqual]", 
           RowBox[{"6", " ", "\[Beta]0", " ", "\[Beta]2"}]}]}], ")"}]}], 
       ")"}], "&&", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]2", " ", 
           SuperscriptBox["\[Kappa]", "2"]}], "]"}], ">", 
         RowBox[{"Abs", "[", "\[Beta]0", "]"}]}], "&&", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           SuperscriptBox["\[Beta]0", "2"], "-", 
           RowBox[{
            SuperscriptBox["\[Beta]2", "2"], " ", 
            SuperscriptBox["\[Kappa]", "4"]}]}], "]"}], ">", 
         RowBox[{"Abs", "[", 
          RowBox[{"\[Beta]1", " ", "\[Kappa]", " ", 
           RowBox[{"(", 
            RowBox[{"\[Beta]0", "-", 
             RowBox[{"\[Beta]2", " ", 
              SuperscriptBox["\[Kappa]", "2"]}]}], ")"}]}], "]"}]}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[Beta]0", "->", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
        RowBox[{"3", " ", "\[Beta]2"}]}]}], "}"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.982741302912447*^9, 3.9827413044304314`*^9}, {
   3.982744891309969*^9, 3.98274490044223*^9}, {3.9827449645057907`*^9, 
   3.982744979386194*^9}, 3.982823899648157*^9, {3.982824926001028*^9, 
   3.9828249360769444`*^9}, {3.9839496036606903`*^9, 3.983949604321991*^9}, {
   3.9839496921847916`*^9, 3.983949693604517*^9}},
 CellLabel->
  "In[100]:=",ExpressionUUID->"bfc00986-27da-cd48-b638-e880e4dbd6a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Beta]2", " ", 
        SuperscriptBox["\[Kappa]", "2"]}], "]"}], ">", 
      RowBox[{"Abs", "[", "\[Beta]0", "]"}]}], "&&", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        SuperscriptBox["\[Beta]0", "2"], "-", 
        RowBox[{
         SuperscriptBox["\[Beta]2", "2"], " ", 
         SuperscriptBox["\[Kappa]", "4"]}]}], "]"}], ">", 
      RowBox[{"Abs", "[", 
       RowBox[{"\[Beta]1", " ", "\[Kappa]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Beta]0", "-", 
          RowBox[{"\[Beta]2", " ", 
           SuperscriptBox["\[Kappa]", "2"]}]}], ")"}]}], "]"}]}]}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{"\[Beta]0", "->", 
     RowBox[{
      RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
      RowBox[{"3", " ", "\[Beta]2"}]}]}], "}"}]}], "//", 
  "Simplify"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"4ba0a8b4-a13d-494b-a410-5678f8508d51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"\[Beta]2", " ", 
      SuperscriptBox["\[Kappa]", "2"]}], "]"}], ">", 
    RowBox[{"Abs", "[", "\[Beta]0", "]"}]}], "&&", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      SuperscriptBox["\[Beta]0", "2"], "-", 
      RowBox[{
       SuperscriptBox["\[Beta]2", "2"], " ", 
       SuperscriptBox["\[Kappa]", "4"]}]}], "]"}], ">", 
    RowBox[{"Abs", "[", 
     RowBox[{"\[Beta]1", " ", "\[Kappa]", " ", 
      RowBox[{"(", 
       RowBox[{"\[Beta]0", "-", 
        RowBox[{"\[Beta]2", " ", 
         SuperscriptBox["\[Kappa]", "2"]}]}], ")"}]}], "]"}]}]}], "//", 
  "TeXForm"}]], "Input",
 CellChangeTimes->{{3.9853375599847107`*^9, 3.985337566390436*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"e3f01ed4-b9cf-2347-b73c-f99c6161b511"],

Cell["\<\
\\left| \\text{$\\beta $2} \\kappa ^2\\right| >| \\text{$\\beta $0}| \\land \
\\left| \\text{$\\beta $0}^2-\\text{$\\beta $2}^2 \\kappa ^4\\right| >\\left|
   \\text{$\\beta $1} \\kappa  \\left(\\text{$\\beta $0}-\\text{$\\beta $2} \
\\kappa ^2\\right)\\right|\
\>", "Output",
 CellChangeTimes->{3.9853375675290756`*^9},
 CellLabel->
  "Out[20]//TeXForm=",ExpressionUUID->"5cf457e7-3cb7-be40-818b-85c9a1c00a9d"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"c3", "[", 
   RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
  RowBox[{"Abs", "[", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["j", "3"], 
         RowBox[{"a", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
        RowBox[{"3", "!"}]], "-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["j", 
          RowBox[{"3", "-", "1"}]], 
         RowBox[{"b", "[", 
          RowBox[{"[", 
           RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", 
        RowBox[{
         RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9827452224681416`*^9, 3.9827452268243427`*^9}, {
  3.9828234166762867`*^9, 3.9828234355517616`*^9}, {3.982823474164467*^9, 
  3.982823481154194*^9}, {3.98282357456456*^9, 3.982823590977844*^9}},
 CellLabel->
  "In[101]:=",ExpressionUUID->"ba59348c-62b3-6842-a3bb-00878d1888a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"c3", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"3", "-", 
       RowBox[{"2", " ", "\[Beta]1"}], "-", 
       RowBox[{"4", " ", "\[Beta]2"}]}], ",", 
      RowBox[{
       RowBox[{"-", "4"}], "+", 
       RowBox[{"2", " ", "\[Beta]1"}], "+", 
       RowBox[{"4", " ", "\[Beta]2"}]}], ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "+", "\[Beta]1", "+", 
       RowBox[{"3", " ", "\[Beta]2"}]}], ",", "\[Beta]1", ",", "\[Beta]2"}], 
     "}"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.9828234867915344`*^9, 3.9828235644961452`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"ceaa906e-97b6-e440-9a85-da60c8daac77"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "12"], " ", 
  RowBox[{"Abs", "[", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
     RowBox[{"8", " ", "\[Beta]2"}]}], 
    RowBox[{
     RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
     RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}]], "Output",
 CellChangeTimes->{{3.9828235831319904`*^9, 3.9828235938831024`*^9}, 
   3.9828243791090755`*^9, {3.983756518313648*^9, 3.9837565336315346`*^9}, 
   3.9839466652189865`*^9, 3.9839496103168697`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"4974b25b-52e9-0148-a422-ac02f539be94"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32step", "[", 
   RowBox[{"\[Beta]1_", ",", "\[Beta]2_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   RowBox[{"Abs", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "4"}], "+", "\[Beta]1", "+", 
      RowBox[{"8", " ", "\[Beta]2"}]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Beta]1", "+", 
      RowBox[{"2", " ", "\[Beta]2"}]}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.98282360214221*^9, 3.9828236189858093`*^9}},
 CellLabel->
  "In[102]:=",ExpressionUUID->"01122362-8b41-4947-9a3b-63cbfa90c2f4"],

Cell[CellGroupData[{

Cell[TextData[{
 "Because Mathematica can\[CloseCurlyQuote]t handle plotting this directly, \
we will just make a table and sample points from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"0", " ", "to", " ", "1"}]}], TraditionalForm]],ExpressionUUID->
  "7e8219b4-fe29-a34c-b0c2-f18e30d6cb45"]
}], "Subsubsection",
 CellChangeTimes->{{3.982825085918909*^9, 
  3.9828251714930935`*^9}},ExpressionUUID->"403cc052-802b-c04c-b2c1-\
fd4b2c522412"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Kappa]list2", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Quiet", "[", 
        RowBox[{
         RowBox[{"Minimize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"c32step", "[", 
              RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "]"}], ",", 
             RowBox[{"cond2step", "/.", " ", 
              RowBox[{"\[Kappa]", "->", "k"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Beta]1", ",", "\[Beta]2"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "1", ",", 
       RowBox[{"1", "/", "100"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.9827449940026627`*^9, {3.982745105996086*^9, 3.9827451579631405`*^9}, 
   3.9828233517283688`*^9, {3.982823632518505*^9, 3.982823659803295*^9}, 
   3.9828239070820217`*^9, 3.982824956374914*^9},
 CellLabel->
  "In[107]:=",ExpressionUUID->"b86305e5-23c3-da47-9756-f5eee8d96f90"]
}, Open  ]],

Cell["\<\
Note that Minimize was used instead of NMinimize because the numerical \
process lead to inconsistencies\
\>", "Subsubsection",
 CellChangeTimes->{{3.982825180021076*^9, 
  3.982825221275591*^9}},ExpressionUUID->"d97b2a88-231c-8a44-a406-\
e6d844f86142"],

Cell[CellGroupData[{

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "!=", "0"}], TraditionalForm]],ExpressionUUID->
  "7f11689b-8cc8-d841-8c75-90e760423213"],
 ", we will artificially add that in, as it corresponds to the BDF2 method"
}], "Subsubsection",
 CellChangeTimes->{{3.982825226385988*^9, 
  3.98282527208712*^9}},ExpressionUUID->"9fad2340-a958-7d49-bc9b-\
b75c6997cec9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Kappa]list2", "=", 
   RowBox[{"\[Kappa]list2", "/.", 
    RowBox[{
     RowBox[{"\[Kappa]list2", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}], "->", 
     RowBox[{"1", "/", "3"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9828250342220592`*^9, 3.982825069588028*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"abe215c8-fdc2-9c4a-b76a-5a983b835bb2"]
}, Open  ]],

