Cell[TextData[{
 "Something important to note here is that this behavior for the 3-step LMM \
with 2 nonzero coefficients does not show the behavior of general 3-step \
methods. For all 3-step LMMs, the behavior of the line will share the same \
two endpoints at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"0", " ", "and", " ", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "367fac16-f058-594c-b714-da239e463671"],
 ", but the Abs[Error] will always remain less than the Abs[Error] for 2-step \
methods for the same \[Kappa] value.\nThis is because despite remaining ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "nd"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "60507f43-867b-0c4d-a26c-a9f8fdf7054f"],
 " order accurate, a higher-step LMM will ",
 StyleBox["always ",
  FontSlant->"Italic"],
 "have a smaller error than a lower-step LMM for the same value of \[Kappa]"
}], "Subsubsection",
 CellChangeTimes->{{3.983759111164833*^9, 
  3.9837594868764534`*^9}},ExpressionUUID->"cb222fb1-54fb-2149-8e81-\
f01a1a62ed92"]
}, Open  ]],

Cell["\<\
Unfortunately, repeating the process for all 3-step methods is too much for \
Mathematica to handle.\
\>", "Subsection",
 CellChangeTimes->{{3.9837567161632442`*^9, 3.983756744146805*^9}, {
  3.98375845156345*^9, 3.983758483279278*^9}, {3.98375851815263*^9, 
  3.9837585613765106`*^9}, {3.9837597093483334`*^9, 
  3.9837597100725975`*^9}},ExpressionUUID->"b66be38d-add9-6d40-8383-\
0bcc762c16e1"]
},
