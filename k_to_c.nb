Cell[CellGroupData[{

Cell["Scenario 2: 3-step LMMs (2 nonzero \[Beta] coefficients)", "Subsection",
 CellChangeTimes->{{3.9827413101685867`*^9, 
  3.9827413339888134`*^9}},ExpressionUUID->"c583c679-c53f-3147-9f43-\
68df6e3a9880"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c32beta", "[", 
   RowBox[{"\[Beta]2_", ",", "\[Beta]3_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "sum"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"a", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         FractionBox["\[Beta]2", "2"], "+", 
         FractionBox[
          RowBox[{"3", " ", "\[Beta]3"}], "2"]}], ",", 
        RowBox[{"3", "-", 
         RowBox[{"2", " ", "\[Beta]2"}], "-", 
         RowBox[{"4", " ", "\[Beta]3"}]}], ",", 
        RowBox[{
         RowBox[{"-", "3"}], "+", 
         FractionBox[
          RowBox[{"3", " ", "\[Beta]2"}], "2"], "+", 
         FractionBox[
          RowBox[{"5", " ", "\[Beta]3"}], "2"]}], ",", "1"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "\[Beta]2", ",", "\[Beta]3"}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"sum", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{"\[Sigma]", "[", "b", "]"}], "[", "1", "]"}]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             SuperscriptBox["j", "3"], 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{"3", "!"}]], "-", 
           FractionBox[
            RowBox[{
             SuperscriptBox["j", 
              RowBox[{"3", "-", "1"}]], 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"j", "+", "1"}], "]"}], "]"}]}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"3", "-", "1"}], ")"}], "!"}]]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "a", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sum", "//", "Simplify"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"7c3d1ee6-08c4-5348-907a-9706e05ad705"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cond2beta", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]3", "\[Equal]", 
         FractionBox["1", "2"]}], "&&", 
        RowBox[{"\[Beta]2", "\[Equal]", 
         FractionBox["1", "2"]}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], "<", "\[Beta]3", "<", 
         FractionBox["3", "5"]}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{"5", " ", "\[Beta]3"}]}], ")"}]}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           SqrtBox[
            RowBox[{"4", "+", 
             RowBox[{"4", " ", "\[Beta]3"}], "-", 
             RowBox[{"15", " ", 
              SuperscriptBox["\[Beta]3", "2"]}]}]]}]}], "\[LessEqual]", 
         "\[Beta]2", "\[LessEqual]", "\[Beta]3"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]3", "\[Equal]", 
         FractionBox["3", "5"]}], "&&", 
        RowBox[{"0", "\[LessEqual]", "\[Beta]2", "\[LessEqual]", 
         FractionBox["3", "5"]}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["3", "5"], "<", "\[Beta]3", "<", 
         FractionBox["2", "3"]}], "&&", 
        RowBox[{
         RowBox[{
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "-", 
             RowBox[{"5", " ", "\[Beta]3"}]}], ")"}]}], "+", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           SqrtBox[
            RowBox[{"4", "+", 
             RowBox[{"4", " ", "\[Beta]3"}], "-", 
             RowBox[{"15", " ", 
              SuperscriptBox["\[Beta]3", "2"]}]}]]}]}], "\[LessEqual]", 
         "\[Beta]2", "\[LessEqual]", "\[Beta]3"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]3", "\[Equal]", 
         FractionBox["2", "3"]}], "&&", 
        RowBox[{"\[Beta]2", "\[GreaterEqual]", 
         RowBox[{"-", 
          FractionBox["2", "3"]}]}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["2", "3"], "<", "\[Beta]3", "<", "1"}], "&&", 
        RowBox[{
         RowBox[{"-", "\[Beta]3"}], "\[LessEqual]", "\[Beta]2", "\[LessEqual]", 
         RowBox[{"2", "-", 
          RowBox[{"2", " ", "\[Beta]3"}]}]}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]3", "\[Equal]", "1"}], "&&", 
        RowBox[{
         RowBox[{"-", "1"}], "\[LessEqual]", "\[Beta]2", "\[LessEqual]", 
         "0"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "<", "\[Beta]3", "<", "2"}], "&&", 
        RowBox[{
         RowBox[{"-", "\[Beta]3"}], "\[LessEqual]", "\[Beta]2", "\[LessEqual]", 
         RowBox[{"2", "-", 
          RowBox[{"2", " ", "\[Beta]3"}]}]}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Beta]3", "\[Equal]", "2"}], "&&", 
        RowBox[{"\[Beta]2", "\[Equal]", 
         RowBox[{"-", "2"}]}]}], ")"}]}], ")"}], "&&", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", 
       RowBox[{"\[Beta]3", " ", "\[Kappa]"}], "]"}], "2"], ">", 
     RowBox[{"Abs", "[", 
      RowBox[{"\[Beta]2", " ", "\[Beta]3", " ", "\[Kappa]"}], "]"}]}]}]}], 
  ";"}]], "Input",
